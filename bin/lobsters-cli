#!/bin/bash
# lobsters-cli: the Cloud Lobsters team setup on this machine. The Claude Code policy and
# rules, the team MCP servers, the tools (gh, jq), basecamp, and the menu-bar icon.
#
# This file is installed root-owned at /usr/local/bin/lobsters-cli and changes only when
# someone runs `lobsters-cli upgrade` and types their password. Nothing it fetches at run
# time is ever executed: the team rules are text, the team plugin is prompts, and the
# policy it installs is what stops either from being anything else.
# Names before this one: claude-lobsters-cli (v0.2.x) and claude-team (v0.1.x); setup moves
# an install under either name over to this one.
#
#   lobsters-cli setup              install or repair (asks for your password once)
#   lobsters-cli check              only report; change nothing
#   lobsters-cli upgrade [X.Y.Z]    fetch a release, verify its signature, show the diff, install
#   lobsters-cli status             refresh and print ~/.local/state/cloud-lobsters/status.json
#                                   (the newest-release lookup is cached for 30 minutes)
#   lobsters-cli remove             take the team setup out again
#   lobsters-cli statusline         one short token for the Claude Code status line
#   lobsters-cli token sync|check   the shared dev-readers 1Password token into the keychain / which Environments it reads
#   lobsters-cli hub ...            the shared agent box: one Unix account per person (lobsters-cli hub help)
#   lobsters-cli version
#
# Layout on disk (all root-owned, all written by `install-files`):
#   /usr/local/bin/lobsters-cli                  this script
#   /usr/local/libexec/lobsters-cli/rules-sync   the only SessionStart hook; pulls the rules
#   /usr/local/share/lobsters-cli/               VERSION, allowed_signers, managed-settings.json,
#                                               mcp-servers.json, swiftbar/, waybar/
# And per user:
#   ~/.local/share/cloud-lobsters/config        read-only clone of the private repo: CLAUDE.md imports
#                                               team/CLAUDE.md; skills/ and agents/ are linked into ~/.claude
#   ~/.local/state/cloud-lobsters/status.json   what the status line, SwiftBar and Waybar read

set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

PREFIX="${LOBSTERS_CLI_PREFIX:-/usr/local}"
SHARE="$PREFIX/share/lobsters-cli"
LIBEXEC="$PREFIX/libexec/lobsters-cli"
TOOLING_REPO="Cloud-Lobsters/lobsters-cli"          # public: releases of this package
CONTENT_REPO="Cloud-Lobsters/claude-config-team"   # private: rules, skills, agents (the plugin marketplace)
SIGNER="release@cloudlobsters.com"                 # principal in allowed_signers
NAMESPACE="lobsters-cli"                           # ssh-keygen -Y namespace
LEGACY_NAMESPACE="claude-lobsters-cli"             # releases up to the rename are signed in this one
TAGLINE="the team setup for every machine"
TAILNET_DOMAIN="cloudlobsters.com"                 # everyone signs in to Tailscale with their Workspace account
HUB_NAME="bin-postboot"                            # the shared agent box's name on the tailnet (ssh lobster)

case "$(uname -s)" in
  Darwin) OS=mac;   MANAGED_DIR="/Library/Application Support/ClaudeCode/managed-settings.d" ;;
  Linux)  OS=linux; MANAGED_DIR="/etc/claude-code/managed-settings.d" ;;
  *) echo "lobsters-cli: unsupported OS $(uname -s)" >&2; exit 1 ;;
esac
MANAGED="$MANAGED_DIR/cloud-lobsters.json"

CLAUDE="$HOME/.claude"
SETTINGS="$CLAUDE/settings.json"
CONFIG="$HOME/.claude.json"
MD="$CLAUDE/CLAUDE.md"
RULES="$HOME/.local/share/cloud-lobsters/config"       # read-only clone of CONTENT_REPO: rules, skills, agents
IMPORT="@~/.local/share/cloud-lobsters/config/team/CLAUDE.md"
STATE_DIR="$HOME/.local/state/cloud-lobsters"
STATE="$STATE_DIR/status.json"
MCP_STATE="$CLAUDE/.lobsters-cli-mcp"               # line 1: hash of mcp-servers.json; then the servers we manage
REQUIRED_MCP="pm"
OPUS="claude-opus-5-5"
SWIFTBAR_APP="/Applications/SwiftBar.app"                  # Mac menu bar: SwiftBar runs share/swiftbar/
SWIFTBAR_LOGIN="$HOME/Library/LaunchAgents/com.cloud-lobsters.swiftbar.plist"   # starts it at login
# Where your code lives, for the basecamp clone. Given once (CODE_DIR=... lobsters-cli setup, or by the
# setup skills, which export it), remembered in ~/.config/cloud-lobsters/code-dir for every later run.
CODE_DIR_FILE="$HOME/.config/cloud-lobsters/code-dir"
if [ -n "${LOBSTERS_CLI_CODE_DIR:-${CODE_DIR:-}}" ]; then
  CODE_DIR="${LOBSTERS_CLI_CODE_DIR:-$CODE_DIR}"
  mkdir -p "$(dirname "$CODE_DIR_FILE")" && echo "$CODE_DIR" > "$CODE_DIR_FILE"
elif [ -s "$CODE_DIR_FILE" ]; then CODE_DIR="$(tr -d '[:space:]' < "$CODE_DIR_FILE")"
else CODE_DIR="$HOME/Documents"; fi
BASECAMP="$CODE_DIR/basecamp"
# A hub is a shared Linux box (the office Mac Pro "lobster") where every person has their own
# Unix account, reached by Tailscale SSH. `hub init` writes HUB_CONF; its presence turns on the
# hub behaviour of `setup` (Claude Code into the home, a file-backed token, git identity from gh).
HUB_CONF="/etc/cloud-lobsters/hub.conf"
HUB_DIR="/etc/cloud-lobsters/hub"                 # root only: people registry, tokens
HUB_LIB="/var/lib/cloud-lobsters/hub"              # the Orca AppImage copied into every new home
HUB=0; [ -f "$HUB_CONF" ] && HUB=1
# Per-user token file on a hub (an ssh-only account has no keyring daemon to ask).
TOKEN_FILE="$HOME/.config/cloud-lobsters/op-token"

installed_version() { { tr -d '[:space:]' < "$SHARE/VERSION"; } 2>/dev/null || echo 0.0.0; }

# ---- output helpers (same vocabulary as the old install.sh) ---------------------------
MODE=install; todo=0
ok()    { [ $MODE = quiet ] || printf '  \033[32m✓\033[0m %s\n' "$1"; }
note()  { [ $MODE = quiet ] || printf '  \033[2m- %s\033[0m\n' "$1"; }
need()  { printf '  \033[33m•\033[0m %s\n' "$1"; todo=$((todo+1)); }
doing() { printf '  \033[36m→\033[0m %s\n' "$1"; }
step()  { printf '\n\033[1m%s\033[0m\n' "$1"; }
die()   { printf 'lobsters-cli: %s\n' "$1" >&2; exit 1; }
# act: in --check mode only report; otherwise say it and return 0 so the caller does it.
act()   { if [ $MODE = check ]; then need "$1"; return 1; fi; doing "$1"; return 0; }
write_through() { local tmp; tmp="$(mktemp)"; cat > "$tmp" && cat "$tmp" > "$1"; rm -f "$tmp"; }
tilde() { echo "${1/#"$HOME"/\~}"; }
sha256() { if command -v shasum >/dev/null; then shasum -a 256 "$@"; else sha256sum "$@"; fi; }
# version_lt A B: true when A < B, numeric per dot-separated field.
version_lt() {
  local a b i; IFS=. read -ra a <<< "$1"; IFS=. read -ra b <<< "$2"
  for i in 0 1 2; do
    [ "${a[i]:-0}" -lt "${b[i]:-0}" ] && return 0
    [ "${a[i]:-0}" -gt "${b[i]:-0}" ] && return 1
  done
  return 1
}
# Git over HTTPS, never a prompt, never a hang: fail if under 1 KB/s for 5 s.
quiet_git() { GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=5 git "$@"; }
# Newest vX.Y.Z tag on the public tooling repo. Read-only, anonymous, one round trip.
# Cached in $STATE_DIR for TAG_TTL_MIN minutes (rules-sync shares the cache and the TTL);
# `latest_version --fresh` always asks. A failed lookup keeps the last answer rather than
# forgetting it, so a blip never makes a machine look up to date.
TAG_TTL_MIN=30
TAG_CACHE="$STATE_DIR/latest-tag"
TAG_STAMP="$STATE_DIR/last-tag-check"
latest_version() {
  local t
  if [ "${1:-}" = --fresh ] || [ ! -f "$TAG_STAMP" ] || [ -n "$(find "$TAG_STAMP" -mmin +$TAG_TTL_MIN 2>/dev/null)" ]; then
    t="$(quiet_git ls-remote --tags --refs "https://github.com/$TOOLING_REPO" 'v[0-9]*' 2>/dev/null \
        | sed -n 's#.*refs/tags/v##p' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
    if [ -n "$t" ]; then mkdir -p "$STATE_DIR"; echo "$t" > "$TAG_CACHE"; touch "$TAG_STAMP"; echo "$t"; return; fi
  fi
  cat "$TAG_CACHE" 2>/dev/null
}

# ---- banner: the lobster -------------------------------------------------------------
# One character per pixel, two pixel rows per terminal line (▀ ▄ half blocks), drawn in
# truecolor when the terminal says it has it and 256 colours otherwise. Three frames make
# the pincer snap once. This block is identical in install.sh and bin/lobsters-cli (the
# installer runs before anything is on disk); scripts/release checks that it still is.
LOBSTER=(
  '......R...............R.................'
  '......R..............R..................'
  '.....R...............R..................'
  '.RRR.R..............R...................'
  'RRRHRRR.............R...................'
  'RRR.RRRR............R...................'
  'RR...RRRR.....HHRRRDRR..................'
  '.....RRRRR...RRRRRRDRRRR................'
  'RRR..RRRRR..RRKRRRDRRRRRRR..............'
  'RRRRRRRRRR..RRRRRRDRRRRRRRR.............'
  '.RRRRRRRRRRRRRRRRDRRRRRRRRRRD...........'
  '..RRRRRRRR.RRRRRRDRRRRRRRRRRDRR.........'
  '...RRRRRR..RRRRRRDRRRRRRRRRRDRRRD.......'
  '...........RRRRRRDRRRRRRRRRDRRRDRRR.....'
  '..........MRRRRRDRRRRRRRRRDRRDRRRRD.....'
  '.....RRRRRRDDMMMMMMMMMMMMMDRRDRRRRDRRR..'
  '....RRRR.RR..DRRDRRDRRDRRD.DMMRRDRRRRD..'
  '...RRR....RR..DR.DR.DR.DR...DMMRDRRRRDPP'
  '...RRR.........D..D..D..D....DMDRRRRDPPP'
  '....RRRRRR.....R..R..R..R.....DRRRDPPPP.'
  '......RRR.......D..D..D..D.....DRRPPPP..'
  '................................PPPPP...'
  '.................................PPP....'
)
# The other two frames as 'row:prefix' deltas: the prefix replaces the first columns of that row.
LOBSTER_OPEN=('0:.....R.................R' '1:.....R.................R' '2:.RR..R................R' '3:RRRR.R...............R' '5:.R.' '6:..' '17:...RRR....RR..RD.RD.RD.RD' '18:...RRR........D..D..D..D.' '19:....RRRRRR....R..R..R..R.' '20:......RRR......D..D..D..D......DRRPPPPP' '21:...............................PPPPPPP' '22:.................................PPPP')
LOBSTER_SHUT=('0:.......R.............R.' '1:.......R' '2:......R' '3:....' '4:.RRRH' '5:RRRR' '6:RRR' '7:.RR' '8:...' '9:....')
lobster_ink() { case $1 in R) INK=$LOB_R ;; M) INK=$LOB_M ;; D) INK=$LOB_D ;; H) INK=$LOB_H ;; P) INK=$LOB_P ;; K) INK=$LOB_K ;; *) INK='' ;; esac; }
# lobster_frame [row:prefix]...: FRAME[] gets the terminal lines of one frame.
lobster_frame() {
  local rows=("${LOBSTER[@]}") o n p top bot y x a b sgr ch last line
  for o in "$@"; do n=${o%%:*}; p=${o#*:}; rows[n]="$p${rows[n]:${#p}}"; done
  FRAME=()
  for ((y = 0; y < ${#rows[@]}; y += 2)); do
    top=${rows[y]}; bot=${rows[y+1]:-}; line=''; last=''
    for ((x = 0; x < ${#top}; x++)); do
      lobster_ink "${top:x:1}"; a=$INK; lobster_ink "${bot:x:1}"; b=$INK
      if [ -n "$a" ] && [ -n "$b" ]; then sgr="\033[38;$LOB_DEPTH;$a;48;$LOB_DEPTH;${b}m"; ch='▀'
      elif [ -n "$a" ]; then sgr="\033[0;38;$LOB_DEPTH;${a}m"; ch='▀'
      elif [ -n "$b" ]; then sgr="\033[0;38;$LOB_DEPTH;${b}m"; ch='▄'
      else sgr='\033[0m'; ch=' '; fi
      [ "$sgr" = "$last" ] || { line="$line$sgr"; last=$sgr; }
      line="$line$ch"
    done
    FRAME[${#FRAME[@]}]="$line\033[0m"
  done
}
# lobster_banner DETAIL TAGLINE: "Cloud Lobsters", "lobsters-cli DETAIL" and TAGLINE beside the
# lobster (under it on a narrow terminal), animated once. Just the words when stdout is not a
# UTF-8 terminal, NO_COLOR is set or TERM is dumb. LOBSTERS_CLI_NO_BANNER=1 prints nothing.
lobster_banner() {
  local detail="$1" tagline="$2" i n cols
  local -a text f0 f1 f2
  [ -z "${LOBSTERS_CLI_NO_BANNER:-}" ] || return 0
  if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ] \
     || ! { echo "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" | grep -qi 'utf-\{0,1\}8'; }; then
    printf '\nCloud Lobsters · lobsters-cli%s · %s\n\n' "${detail:+ $detail}" "$tagline"; return 0
  fi
  case ${COLORTERM:-} in
    truecolor|24bit) LOB_DEPTH=2; LOB_R='227;57;43'; LOB_M='196;42;34'; LOB_D='140;22;22'; LOB_H='255;118;98'; LOB_P='242;150;140'; LOB_K='24;12;12' ;;
    *)               LOB_DEPTH=5; LOB_R=160; LOB_M=124; LOB_D=88; LOB_H=209; LOB_P=217; LOB_K=232 ;;
  esac
  text=("\033[1mCloud Lobsters\033[0m" "\033[38;$LOB_DEPTH;${LOB_R}mlobsters-cli\033[0m${detail:+ $detail}" "\033[2m$tagline\033[0m")
  lobster_frame;                      f0=("${FRAME[@]}")
  lobster_frame "${LOBSTER_OPEN[@]}"; f1=("${FRAME[@]}")
  lobster_frame "${LOBSTER_SHUT[@]}"; f2=("${FRAME[@]}")
  n=${#f0[@]}
  cols=$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")
  if [ "${cols:-80}" -ge 80 ]; then
    for i in 0 1 2; do f0[i+4]="${f0[i+4]}   ${text[i]}"; f1[i+4]="${f1[i+4]}   ${text[i]}"; f2[i+4]="${f2[i+4]}   ${text[i]}"; done
  else
    for i in 0 1 2; do f0[n+i]=${text[i]}; f1[n+i]=${text[i]}; f2[n+i]=${text[i]}; done
    n=$((n + 3))
  fi
  echo; printf '%b\n' "${f0[@]}"
  for i in 1 0 2 0 1 2 0; do
    sleep 0.13; printf '\033[%dA' "$n"
    case $i in 0) printf '%b\n' "${f0[@]}" ;; 1) printf '%b\n' "${f1[@]}" ;; 2) printf '%b\n' "${f2[@]}" ;; esac
  done
  echo
}
# ---- end banner ----------------------------------------------------------------------

# ---- status.json --------------------------------------------------------------------
# Written here and by rules-sync; read by `statusline`, SwiftBar and Waybar.
write_status() { # $1 latest tooling version or "", $2 rules head, $3 rules last sync (ISO) or "", $4.. changed-by
  local inst lat state
  inst="$(installed_version)"; lat="${1:-}"
  if [ ! -x "$PREFIX/bin/lobsters-cli" ] || [ ! -f "$MANAGED" ]; then state=not-installed
  elif [ -n "$lat" ] && version_lt "$inst" "$lat"; then state=update-available
  elif [ -n "${3:-}" ] && [ -n "$(find "$STATE_DIR/last-sync" -mtime +7 2>/dev/null)" ]; then state=stale
  else state=synced; fi
  mkdir -p "$STATE_DIR"
  jq -n --arg inst "$inst" --arg lat "$lat" --arg head "${2:-}" --arg sync "${3:-}" --arg state "$state" \
    --arg who "$(shift 3 2>/dev/null; printf '%s\n' "$@" | paste -sd, -)" '{
      tooling: {installed: $inst, latest: (if $lat == "" then null else $lat end)},
      rules:   {head: (if $head == "" then null else $head end), lastSync: (if $sync == "" then null else $sync end),
                changedBy: (if $who == "" then [] else ($who | split(",")) end)},
      state:   $state, updatedAt: (now | todate)}' > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

cmd_status() {
  local lat head sync
  lat="$(latest_version)"
  head="$(git -C "$RULES" rev-parse --short HEAD 2>/dev/null)"
  sync="$([ -f "$STATE_DIR/last-sync" ] && date -u -r "$STATE_DIR/last-sync" +%FT%TZ 2>/dev/null)"
  write_status "$lat" "$head" "$sync"
  jq . "$STATE"
}

# The status line. `setup` points your statusLine here and keeps the command you had in
# OWN_STATUSLINE; this runs that first (same stdin), then adds the lobster: 🦞 0.1.2 means
# this machine runs the current team release. `remove` puts your own command back.
OWN_STATUSLINE="$HOME/.config/cloud-lobsters/own-statusline"
team_segment() {
  local state inst lat
  state="$(jq -r '.state // "not-installed"' "$STATE" 2>/dev/null)"
  inst="$(jq -r '.tooling.installed // ""' "$STATE" 2>/dev/null)"
  lat="$(jq -r '.tooling.latest // ""' "$STATE" 2>/dev/null)"
  case "$state" in
    synced)           printf '🦞 %s' "$inst" ;;
    update-available) printf '🦞 %s → %s' "$inst" "$lat" ;;
    stale)            printf '🦞 %s stale' "$inst" ;;
    *)                printf '🦞 ✗' ;;
  esac
}
cmd_statusline() {
  local input own out first rest
  input="$(cat)"
  own="$(cat "$OWN_STATUSLINE" 2>/dev/null)"
  # Before setup has wrapped it, an own command may still sit in settings.json; honour that too.
  [ -n "$own" ] || { own="$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null)"; [ "$own" = "$PREFIX/bin/lobsters-cli statusline" ] && own=""; }
  out=""; [ -n "$own" ] && out="$(printf '%s' "$input" | bash -c "$own" 2>/dev/null)"
  if [ -z "$out" ]; then team_segment; echo; return; fi
  first="${out%%$'\n'*}"; rest="${out#"$first"}"
  printf '%s · %s%s\n' "$first" "$(team_segment)" "$rest"
}

# ---- setup / check / remove ---------------------------------------------------------
setup_prereqs() {
  step "0. Before you start"
  command -v jq >/dev/null     || die "jq is missing (install.sh installs it; or: brew install jq / apt install jq / pacman -S jq)"
  if command -v claude >/dev/null; then ok "Claude Code"
  elif [ $HUB = 1 ] && [ $MODE = install ]; then
    doing "install Claude Code into this home"
    local inst; inst="$(mktemp)"
    { curl -fsSL https://claude.ai/install.sh -o "$inst" && bash "$inst"; } > "$inst.log" 2>&1
    hash -r
    if command -v claude >/dev/null; then ok "Claude Code $(claude --version 2>/dev/null | head -1)"; rm -f "$inst" "$inst.log"
    else tail -5 "$inst.log" | sed 's/^/    /'; rm -f "$inst" "$inst.log"; die "Claude Code did not install: curl -fsSL https://claude.ai/install.sh | bash"; fi
  elif [ $HUB = 1 ] && [ $MODE = check ]; then need "Claude Code (setup installs it into this home)"
  else die "Claude Code is missing: curl -fsSL https://claude.ai/install.sh | bash"; fi
  command -v gh >/dev/null     && ok "GitHub CLI" || die "gh is missing ($([ $HUB = 1 ] && echo 'an admin runs: sudo lobsters-cli hub init' || echo 'install.sh installs it'))"
  [ $MODE = remove ] && return
  # Not signed in: with a terminal, run the login here (device code: open github.com/login/device
  # on any browser, type the code). On a hub nothing opens a browser on the box itself.
  if gh auth status >/dev/null 2>&1; then ok "GitHub (gh) signed in"
  elif [ $MODE = install ] && [ -t 0 ]; then
    doing "sign in to GitHub as yourself: type the code it shows at github.com/login/device"
    if env ${HUB:+$([ $HUB = 1 ] && echo BROWSER=true)} gh auth login --web --git-protocol https --scopes user:email </dev/tty && gh auth status >/dev/null 2>&1; then
      ok "GitHub (gh) signed in as $(gh api user --jq .login 2>/dev/null)"
    else die "GitHub sign-in did not complete; run setup again"; fi
  elif [ $HUB = 1 ] && [ $MODE = check ]; then need "GitHub: not signed in (setup signs you in)"; return
  else die "sign in to GitHub first: gh auth login"; fi
  if git config --global --get-all credential.https://github.com.helper 2>/dev/null | grep -q 'gh auth'; then ok "git uses your gh login"
  elif act "let git use your gh login, so the private rules repo can be cloned"; then gh auth setup-git; fi
}

# The install before this one linked things into ~/.claude straight from a clone of the
# content repo. Take those links out so the two never fight; the content now arrives as a
# plugin and the rules through rules-sync.
setup_migrate_old() {
  local f old
  old="$(readlink "$MANAGED" 2>/dev/null)"
  case "$old" in */claude-config-team/team/settings.json)
    act "remove the old managed-settings symlink (asks for your password)" && sudo rm -f "$MANAGED" ;;
  esac
  if [ -L "$CLAUDE/claude-config-team" ]; then
    act "remove the old ~/.claude/claude-config-team link" && rm -f "$CLAUDE/claude-config-team"
  fi
  if [ -f "$MD" ]; then
    while IFS= read -r old; do
      act "remove the old team import $old" && awk -v l="$old" '$0==l {skip=1; next} skip && $0=="" {skip=0; next} {skip=0; print}' "$MD" | write_through "$MD"
    done < <(grep -x '@.*/claude-config-team/team/CLAUDE\.md' "$MD")
  fi
  for f in "$CLAUDE"/skills/* "$CLAUDE"/agents/*; do
    [ -L "$f" ] || continue
    case "$(readlink "$f")" in "$RULES"/*) ;; */claude-config-team/skills/*|*/claude-config-team/agents/*)
      act "unlink $(tilde "$f") (rules-sync relinks it from $(tilde "$RULES"))" && rm -f "$f" ;;
    esac
  done
  # Until v0.2.0 this package was called claude-team. Take that copy out; the status line and
  # the MCP state move over; setup_managed replaces the policy file (new hook path) below.
  if [ -e "$PREFIX/bin/claude-team" ] || [ -d "$PREFIX/share/claude-team" ] || [ -d "$PREFIX/libexec/claude-team" ]; then
    act "remove the old claude-team install from $PREFIX (asks for your password)" \
      && sudo rm -rf "$PREFIX/bin/claude-team" "$PREFIX/libexec/claude-team" "$PREFIX/share/claude-team"
  fi
  if [ "$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null)" = "$PREFIX/bin/claude-team statusline" ]; then
    act "point the status line at lobsters-cli" \
      && jq --arg sl "$PREFIX/bin/lobsters-cli statusline" '.statusLine.command = $sl' "$SETTINGS" | write_through "$SETTINGS"
  fi
  # Until v0.3.0 it was called claude-lobsters-cli. An old `claude-lobsters-cli upgrade` installs
  # this release's files under the old names (the release carries copies for it) and then runs
  # this script, which lands here: install the same files under the new names (one sudo), take
  # the old ones out, and carry on as lobsters-cli. The user-level bits follow below.
  local oldbin="$PREFIX/bin/claude-lobsters-cli" oldshare="$PREFIX/share/claude-lobsters-cli" stage
  if [ -e "$oldbin" ] || [ -d "$oldshare" ] || [ -d "$PREFIX/libexec/claude-lobsters-cli" ]; then
    if [ ! -x "$PREFIX/bin/lobsters-cli" ] && cmp -s "$oldbin" "$0" \
       && act "install this release as lobsters-cli (asks for your password)"; then
      stage="$(mktemp -d)"
      mkdir -p "$stage/bin" "$stage/libexec" "$stage/share/swiftbar" "$stage/share/waybar"
      cp "$oldbin" "$stage/bin/lobsters-cli"
      cp "$PREFIX/libexec/claude-lobsters-cli/rules-sync" "$stage/libexec/"
      cp "$oldshare/VERSION" "$stage/"
      cp "$oldshare/allowed_signers" "$oldshare/managed-settings.json" "$oldshare/mcp-servers.json" "$stage/share/"
      cp "$oldshare/swiftbar/claude-lobsters-cli.5m.sh" "$stage/share/swiftbar/lobsters-cli.5m.sh"
      cp "$oldshare/waybar/claude-lobsters-cli.sh" "$stage/share/waybar/lobsters-cli.sh"
      cp "$oldshare/waybar/README.md" "$stage/share/waybar/"
      chmod 0755 "$stage/bin/lobsters-cli"
      sudo bash "$stage/bin/lobsters-cli" install-files "$stage" || die "could not install lobsters-cli"
      rm -rf "$stage"
    fi
    if [ -x "$PREFIX/bin/lobsters-cli" ] && act "remove the old claude-lobsters-cli install from $PREFIX (asks for your password)"; then
      sudo rm -rf "$oldbin" "$PREFIX/libexec/claude-lobsters-cli" "$oldshare"
      # Started as the old binary? Carry on as the new one; it does the user-level bits below.
      [ "$0" = "$oldbin" ] && LOBSTERS_CLI_NO_BANNER=1 exec "$PREFIX/bin/lobsters-cli" setup
    fi
  fi
  if [ "$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null)" = "$PREFIX/bin/claude-lobsters-cli statusline" ]; then
    act "point the status line at lobsters-cli" \
      && jq --arg sl "$PREFIX/bin/lobsters-cli statusline" '.statusLine.command = $sl' "$SETTINGS" | write_through "$SETTINGS"
  fi
  # The earlier scripts remembered which MCP servers they added; those are the same servers.
  for old in .claude-lobsters-cli-mcp .claude-lobster-mcp .claude-team-mcp .claude-config-team-mcp; do
    [ -f "$CLAUDE/$old" ] || continue
    [ -f "$MCP_STATE" ] && rm -f "$CLAUDE/$old" || mv "$CLAUDE/$old" "$MCP_STATE"
  done
  return 0
}

setup_managed() {
  step "1. Team policy (managed settings)"
  local src="$SHARE/managed-settings.json"
  if [ $MODE = remove ]; then
    if [ -e "$MANAGED" ] || [ -L "$MANAGED" ]; then
      doing "turn off the team policy (asks for your password)"; sudo rm -f "$MANAGED" || need "could not remove $MANAGED"
    else ok "team policy is off"; fi
    return
  fi
  [ -f "$src" ] || die "$src is missing; run lobsters-cli upgrade"
  if [ -f "$MANAGED" ] && [ ! -L "$MANAGED" ] && cmp -s "$src" "$MANAGED"; then ok "team policy is on ($(tilde "$MANAGED"))"; return; fi
  if [ -f "$MANAGED" ] && [ ! -L "$MANAGED" ]; then
    echo "  policy changes:"; diff -u "$MANAGED" "$src" | sed -n '3,$p' | sed 's/^/    /'
  fi
  if act "install the team policy to $MANAGED (asks for your password)"; then
    if sudo -n true 2>/dev/null || [ -t 0 ] || [ -r /dev/tty ]; then
      sudo mkdir -p "$MANAGED_DIR" && sudo install -m 0644 -o root "$src" "$MANAGED" || need "team policy not installed"
    else need "the team policy needs your password: run this in a terminal"; fi
  fi
}

setup_rules() {
  step "2. Team rules"
  if [ $MODE = remove ]; then
    if [ -f "$MD" ] && grep -qxF "$IMPORT" "$MD"; then
      doing "remove the team import from ~/.claude/CLAUDE.md"
      awk -v l="$IMPORT" '$0==l {skip=1; next} skip && $0=="" {skip=0; next} {skip=0; print}' "$MD" | write_through "$MD"
    else ok "no team import in ~/.claude/CLAUDE.md"; fi
    note "the rules clone at $(tilde "$RULES") is left in place; delete it if you like"
    return
  fi
  if [ -d "$RULES/.git" ]; then ok "team config clone at $(tilde "$RULES")"
  elif act "clone the team config to $(tilde "$RULES") (read-only copy of $CONTENT_REPO)"; then
    mkdir -p "$(dirname "$RULES")"
    quiet_git clone -q "https://github.com/$CONTENT_REPO" "$RULES" || need "could not clone $CONTENT_REPO: is your gh login allowed to read it?"
  fi
  if [ -f "$MD" ] && grep -qxF "$IMPORT" "$MD"; then ok "~/.claude/CLAUDE.md imports the team rules"
  elif act "import the team rules on the first line of ~/.claude/CLAUDE.md"; then
    mkdir -p "$CLAUDE"; [ -e "$MD" ] || touch "$MD"
    { echo "$IMPORT"; [ -s "$MD" ] && { echo; cat "$MD"; }; } | write_through "$MD"
  fi
  # Skills and agents are linked by rules-sync at every session start; do it once now too.
  if [ $MODE != check ] && [ -d "$RULES/.git" ] && [ -x "$LIBEXEC/rules-sync" ]; then
    "$LIBEXEC/rules-sync" --link-only >/dev/null 2>&1 && ok "team skills and agents linked into ~/.claude"
  fi
}

setup_model() {
  step "3. Model (set only where you have nothing; yours wins)"
  [ -s "$SETTINGS" ] || { [ $MODE = check ] || { mkdir -p "$CLAUDE"; echo '{}' > "$SETTINGS"; }; }
  if [ -s "$SETTINGS" ] && ! jq empty "$SETTINGS" 2>/dev/null; then need "~/.claude/settings.json is not valid JSON, so nothing was set"; return; fi
  local missing
  missing="$(jq -r --arg m "$OPUS" '[(if has("model") then empty else "model" end),
    (if has("alwaysThinkingEnabled") then empty else "thinking" end),
    (if .modelSettings[$m].effortLevel then empty else "effort" end)] | join(", ")' "$SETTINGS" 2>/dev/null || echo "model, thinking, effort")"
  if [ -z "$missing" ]; then ok "model, effort and thinking are set"
  elif act "set the team default for: $missing (Opus, effort xhigh, thinking on)"; then
    jq --arg m "$OPUS" '(if has("model") then . else .model = "opus" end)
      | (if has("alwaysThinkingEnabled") then . else .alwaysThinkingEnabled = true end)
      | (if .modelSettings[$m].effortLevel then . else .modelSettings[$m].effortLevel = "xhigh" end)' "$SETTINGS" | write_through "$SETTINGS"
  fi
  local own ours="$PREFIX/bin/lobsters-cli statusline"
  own="$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null)"
  if [ "$own" = "$ours" ]; then ok "status line shows the 🦞 team segment$([ -s "$OWN_STATUSLINE" ] && echo ' after your own')"
  elif [ -n "$own" ]; then
    if act "keep your status line and add the 🦞 team segment after it"; then
      mkdir -p "$(dirname "$OWN_STATUSLINE")" && printf '%s' "$own" > "$OWN_STATUSLINE"
      jq --arg sl "$ours" '.statusLine.command = $sl | .statusLine.type = "command"' "$SETTINGS" | write_through "$SETTINGS"
    fi
  elif act "show the 🦞 team segment in the status line"; then
    jq --arg sl "$ours" '.statusLine = {type: "command", command: $sl}' "$SETTINGS" | write_through "$SETTINGS"
  fi
}

setup_mcp() {
  step "4. MCP servers (keys from your 1Password item claude-code-mcp)"
  local src="$SHARE/mcp-servers.json" ours hash current op_ok name raw have cmd want field found
  local -a keep=(); local failed=0
  ours="$([ -f "$MCP_STATE" ] && tail -n +2 "$MCP_STATE")"
  is_ours() { printf '%s\n' "$ours" | grep -qxF "$1"; }
  if [ $MODE = remove ]; then
    for name in $ours; do act "remove MCP server $name" && claude mcp remove -s user "$name" </dev/null >/dev/null 2>&1; done
    rm -f "$MCP_STATE"; return
  fi
  [ -f "$src" ] || die "$src is missing; run lobsters-cli upgrade"
  hash="$(sha256 < "$src" | cut -c1-40)"
  current="$(jq '.mcpServers // {}' "$CONFIG" 2>/dev/null || echo '{}')"
  op_ok=""; op_err=""
  for name in $(jq -r 'keys[]' "$src"); do
    raw="$(jq -c --arg n "$name" '.[$n]' "$src")"
    have="$(echo "$current" | jq -cS --arg n "$name" '.[$n] // empty')"
    cmd="$(echo "$raw" | jq -r 'if .type == "stdio" then .command else empty end')"
    # A stdio server's command is written for one OS (the 1Password MCP lives in the Mac app
    # bundle; Linux installs it as /usr/bin/1password-mcp). The list names the Mac path; any other
    # machine finds the same program by its name on PATH and uses that.
    if [ -n "$cmd" ] && [ ! -x "$cmd" ]; then
      found="$(command -v "$(basename "$cmd")" 2>/dev/null || true)"
      if [ -n "$found" ]; then raw="$(echo "$raw" | jq -c --arg c "$found" '.command = $c')"; cmd="$found"
      else note "$name: skipped, $cmd is not on this machine"; continue; fi
    fi
    if echo "$raw" | grep -q 'op://'; then
      # One probe per run. 1Password may show an "allow CLI access" dialog here: approving it is enough.
      if [ -z "$op_ok" ]; then
        if [ $HUB = 1 ] && ! op whoami </dev/null >/dev/null 2>&1; then op_ok=hub
        elif op_err="$(op vault list </dev/null 2>&1 >/dev/null)"; then op_ok=1
        else op_ok=0; op_err="$(echo "$op_err" | sed 's/^\[ERROR\] [0-9/: ]*//' | head -1)"; fi
      fi
      if [ "$op_ok" = hub ]; then note "$name: skipped on the hub (no 1Password app here; op signin as yourself, then setup again, adds it)"; continue; fi
      if [ "$op_ok" = 0 ]; then need "$name not added. 1Password said: ${op_err:-no answer}. Approve its prompt if one appeared, or unlock it, or turn on Settings → Developer → Integrate with 1Password CLI; then run lobsters-cli setup again"; failed=1; continue; fi
      field="$(echo "$raw" | grep -o 'op://[^ }"]*' | head -1)"
      if ! want="$(echo "$raw" | op inject 2>/tmp/lobsters-cli-op.$$)"; then
        op_err="$(sed 's/^\[ERROR\] [0-9/: ]*//' /tmp/lobsters-cli-op.$$ | head -1)"; rm -f /tmp/lobsters-cli-op.$$
        if [ "$name" = "$REQUIRED_MCP" ]; then need "$name is required but 1Password has no value at $field (${op_err:-unknown error}). Create the item (see README), then run lobsters-cli setup again"
        else note "$name: skipped, no value at $field"; fi
        continue
      fi
      rm -f /tmp/lobsters-cli-op.$$
    else want="$raw"; fi
    want="$(echo "$want" | jq -cS .)"
    if [ "$want" = "$have" ]; then keep+=("$name"); ok "MCP $name"; continue; fi
    if [ -n "$have" ] && ! is_ours "$name"; then note "MCP $name: you have your own, so the team one is skipped"; continue; fi
    if act "add MCP server $name"; then
      [ -n "$have" ] && claude mcp remove -s user "$name" </dev/null >/dev/null 2>&1
      if claude mcp add-json -s user "$name" "$want" </dev/null >/dev/null 2>&1; then keep+=("$name")
      else need "could not add MCP server $name"; failed=1; fi
    fi
  done
  for name in $ours; do
    jq -e --arg n "$name" 'has($n)' "$src" >/dev/null && continue
    act "remove MCP server $name (the team dropped it)" && claude mcp remove -s user "$name" </dev/null >/dev/null 2>&1
  done
  if [ $MODE != check ]; then
    [ "$failed" = 0 ] || hash="retry"
    mkdir -p "$CLAUDE"
    { echo "$hash"; [ ${#keep[@]} -gt 0 ] && printf '%s\n' "${keep[@]}"; } > "$MCP_STATE"
  fi
}

setup_extras() {
  step "5. Basecamp and the menu bar"
  if [ -d "$BASECAMP/.git" ]; then ok "$(tilde "$BASECAMP")"
  elif act "clone Cloud-Lobsters/basecamp to $(tilde "$BASECAMP")"; then
    gh repo clone Cloud-Lobsters/basecamp "$BASECAMP" -- -q || need "could not clone basecamp"
  fi
  if [ $OS = mac ]; then
    # The menu-bar icon is a SwiftBar plugin. SwiftBar asks for a plugin folder on first open,
    # so set one first; it starts at login through a LaunchAgent of ours (`remove` takes it out).
    local sb
    if [ -d "$SWIFTBAR_APP" ]; then ok "SwiftBar"
    elif ! command -v brew >/dev/null; then need "SwiftBar (the menu-bar icon) needs Homebrew: install it, then run setup again"
    elif act "install SwiftBar, for the menu-bar icon"; then brew install --cask swiftbar >/dev/null || need "could not install SwiftBar"; fi
    if [ -d "$SWIFTBAR_APP" ]; then
      sb="$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)"
      if [ -z "$sb" ] && act "give SwiftBar a plugin folder"; then
        sb="$HOME/Library/Application Support/SwiftBar/Plugins"
        defaults write com.ameba.SwiftBar PluginDirectory "$sb"
      fi
      if [ -n "$sb" ]; then
        [ $MODE = check ] || mkdir -p "$sb"
        rm -f "$sb/claude-team.5m.sh" "$sb/claude-lobsters-cli.5m.sh"   # the plugin's names before v0.2.0 and v0.3.0
        if [ "$(readlink "$sb/lobsters-cli.5m.sh" 2>/dev/null)" = "$SHARE/swiftbar/lobsters-cli.5m.sh" ]; then ok "SwiftBar plugin"
        elif act "add the SwiftBar plugin"; then ln -sfn "$SHARE/swiftbar/lobsters-cli.5m.sh" "$sb/lobsters-cli.5m.sh"; fi
      fi
      if [ -f "$SWIFTBAR_LOGIN" ]; then ok "SwiftBar starts at login"
      elif act "start SwiftBar at login"; then
        mkdir -p "$(dirname "$SWIFTBAR_LOGIN")"
        cat > "$SWIFTBAR_LOGIN" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$(basename "$SWIFTBAR_LOGIN" .plist)</string>
  <key>ProgramArguments</key><array><string>/usr/bin/open</string><string>-a</string><string>SwiftBar</string></array>
  <key>RunAtLoad</key><true/>
</dict></plist>
EOF
      fi
      [ $MODE = check ] || pgrep -xq SwiftBar || open -a SwiftBar
    fi
  elif [ $HUB = 1 ]; then hub_setup_person
  else
    note "Waybar: add the module from $SHARE/waybar/README.md"
  fi
}

# On a hub, the part of a person's account that carries their identity. Runs as the person.
hub_setup_person() {
  local name email login id unit="$HOME/.config/systemd/user/orca-serve.service" paired
  . "$HUB_CONF"
  if [ -n "${HUB_RETIRED:-}" ] && [ "$USER" = "$HUB_RETIRED" ]; then
    note "$USER is the shared desktop account, not a person: no Orca server, no identity here. People use their own accounts (lobsters-cli hub list)"
    return
  fi
  # Commits from this account are the whole point: name and email from the GitHub login.
  if [ -n "$(git config --global user.email 2>/dev/null)" ] && [ -n "$(git config --global user.name 2>/dev/null)" ]; then
    ok "git commits as $(git config --global user.name) <$(git config --global user.email)>"
  elif act "set your git name and email from your GitHub account"; then
    login="$(gh api user --jq .login 2>/dev/null)"; id="$(gh api user --jq .id 2>/dev/null)"
    name="$(gh api user --jq '.name // empty' 2>/dev/null)"; [ -n "$name" ] || name="$login"
    email="$(gh api user/emails --jq '.[] | select(.primary and .verified) | .email' 2>/dev/null | head -1)"
    [ -n "$email" ] || email="$(gh api user --jq '.email // empty' 2>/dev/null)"
    [ -n "$email" ] || email="$id+$login@users.noreply.github.com"
    if [ -n "$login" ]; then git config --global user.name "$name"; git config --global user.email "$email"; ok "git commits as $name <$email>"
    else need "gh gave no account; sign in (gh auth login) and run setup again"; fi
  fi
  if [ -s "$CLAUDE/.credentials.json" ]; then ok "Claude Code signed in"
  else need "sign in to Claude Code with the company account: run claude, open the URL it prints on your laptop"; fi
  if [ ! -f "$unit" ]; then need "no Orca server in this account: an admin runs sudo lobsters-cli hub add $USER@… again"; return; fi
  if systemctl --user is-enabled orca-serve.service >/dev/null 2>&1; then ok "Orca server unit enabled"
  elif act "enable your Orca server"; then systemctl --user enable orca-serve.service >/dev/null 2>&1 || need "could not enable orca-serve"; fi
  paired="$(jq 'if type == "array" then length else 0 end' "$HOME/.config/orca/orca-devices.json" 2>/dev/null || echo 0)"
  if [ "${paired:-0}" -gt 0 ]; then
    if systemctl --user is-active orca-serve.service >/dev/null 2>&1; then ok "Orca server running ($paired device(s) paired)"
    elif act "start your Orca server ($paired device(s) paired)"; then systemctl --user start orca-serve.service || need "orca-serve did not start: journalctl --user -u orca-serve"; fi
  else need "pair your phone or laptop with Orca: orca-pair (prints the link; your server starts by itself once paired)"; fi
}

# ---- the 1Password service-account token ---------------------------------------------
# Every repo's scripts/op-env.sh runs `op` as this token when the OS keychain holds it, so a dev
# server starts while 1Password is locked (a phone through Orca); without it op asks the desktop
# app. The team shares ONE read-only service account, dev-readers (dev Environments only; SEC014,
# revised 2026-10-30): its token is the item named below in the Engineering vault. setup copies it into
# the keychain while 1Password is unlocked (read by title: 1Password's default item name for a
# saved service-account token), so a new dev does nothing and a rotated token reaches
# every machine at its next setup (or `lobsters-cli token sync`). Someone who stored a token of
# their own keeps it: the item label tells the two apart. The vault is the only way in: there
# is no paste path, so no token travels outside 1Password. Keychain item: service
# 1password-service-account on every OS (macOS Keychain via `security`, Linux Secret Service via
# `secret-tool`). The token is only ever piped: into sha256, the keychain tool, or op's
# environment; never printed, never through an agent. basecamp ADR 0057.
TOKEN_SERVICE="1password-service-account"
# 1Password's default title for a saved service-account token, so nobody renames anything.
# A colon is not allowed in an op:// reference, hence `op item get` by title, not `op read`.
TOKEN_VAULT="Engineering"
TOKEN_ITEM="Service Account Auth Token: dev-readers"
TOKEN_REF="$TOKEN_VAULT › $TOKEN_ITEM"
TOKEN_LABEL="1Password service account (shared dev-readers)"
token_present() {
  [ $HUB = 1 ] && { [ -s "$TOKEN_FILE" ]; return; }
  case $OS in
    mac)   security find-generic-password -s "$TOKEN_SERVICE" -w >/dev/null 2>&1 ;;
    linux) command -v secret-tool >/dev/null && secret-tool lookup service "$TOKEN_SERVICE" >/dev/null 2>&1 ;;
  esac
}
token_read() {
  [ $HUB = 1 ] && { cat "$TOKEN_FILE" 2>/dev/null; return; }
  case $OS in
    mac)   security find-generic-password -s "$TOKEN_SERVICE" -w 2>/dev/null ;;
    linux) secret-tool lookup service "$TOKEN_SERVICE" 2>/dev/null ;;
  esac
}
token_label() {
  [ $HUB = 1 ] && { cat "$TOKEN_FILE.label" 2>/dev/null; return; }
  case $OS in
    mac)   security find-generic-password -s "$TOKEN_SERVICE" 2>/dev/null | sed -n 's/.*"labl"<blob>="\(.*\)"$/\1/p' | head -1 ;;
    linux) secret-tool search service "$TOKEN_SERVICE" 2>/dev/null | sed -n 's/^label = //p' | head -1 ;;
  esac
}
# token_store LABEL: the token on stdin goes into the keychain, replacing the item.
token_store() {
  [ $HUB = 1 ] && { (umask 077; mkdir -p "$(dirname "$TOKEN_FILE")" && cat > "$TOKEN_FILE" && echo "$1" > "$TOKEN_FILE.label"); return; }
  case $OS in
    # `security` takes the secret only as an argument or a prompt, so for this one call it is
    # an argument (visible to this user's own processes for that instant).
    mac)   security add-generic-password -U -s "$TOKEN_SERVICE" -a "$USER" -l "$1" -w "$(cat)" ;;
    linux) secret-tool store --label="$1" service "$TOKEN_SERVICE" ;;
  esac
}
token_fp() { token_read | sha256 | cut -c1-16; }
token_remove_hint() { [ $HUB = 1 ] && { echo "rm $(tilde "$TOKEN_FILE")"; return; }; [ $OS = mac ] && echo "security delete-generic-password -s $TOKEN_SERVICE" || echo "secret-tool clear service $TOKEN_SERVICE"; }
# setup_token [force]: the shared token into the keychain, from the vault only. `force` replaces
# a token that is not the shared one. Never prompts: not everyone with lobsters-cli runs dev
# servers or has the Engineering vault, and those who don't must not get the token.
setup_token() {
  step "6. 1Password service-account token (engineers: dev servers start with 1Password locked)"
  local opv shared want have label
  # Every repo's scripts/op-env.sh runs `op run --environment`, which needs op 2.41.0 or later.
  opv="$(op --version 2>/dev/null | sed 's/-.*//')"
  if [ -n "$opv" ] && [ "$(echo "$opv" | awk -F. '{printf "%d%03d%03d", $1,$2,$3}')" -lt 2041000 ]; then
    need "op is $opv; scripts/op-env.sh needs 2.41.0 or later ($([ $OS = mac ] && echo 'brew upgrade --cask 1password-cli' || echo 'update 1password-cli with your package manager'))"
  fi
  if [ $HUB = 1 ]; then
    # No 1Password app on a hub: `hub add` places the shared token, from the admin's 1Password.
    if token_present; then ok "the shared dev-readers token is in $(tilde "$TOKEN_FILE"); op run works here"
    else note "no dev-readers token in this home. An admin: sudo lobsters-cli hub token dev-readers (see lobsters-cli hub help)"; fi
    return
  fi
  if [ $OS = linux ] && ! command -v secret-tool >/dev/null; then
    note "no secret-tool, so no token can be stored (Ubuntu: sudo apt install libsecret-tools; Omarchy has it)"; return
  fi
  # The shared token, through the desktop app (unlocked, with access to the Engineering vault).
  shared="$(op item get "$TOKEN_ITEM" --vault "$TOKEN_VAULT" --fields label=credential --reveal </dev/null 2>/dev/null)" || shared=""
  case "$shared" in ops_*) ;; *) shared="" ;; esac
  if [ -n "$shared" ]; then
    want="$(printf '%s' "$shared" | sha256 | cut -c1-16)"
    have=""; token_present && have="$(token_fp)"
    label="$(token_label)"
    if [ "$have" = "$want" ]; then ok "the shared dev-readers token is in the keychain"
    elif [ -n "$have" ] && [ "$label" != "$TOKEN_LABEL" ] && [ "${1:-}" != force ]; then
      note "the keychain holds a different token (\"$label\"); kept. For the shared one: lobsters-cli token sync --shared"
    elif act "$([ -n "$have" ] && echo replace || echo store) the shared dev-readers token in the keychain"; then
      if printf '%s' "$shared" | token_store "$TOKEN_LABEL" && [ "$(token_fp)" = "$want" ]; then
        ok "shared dev-readers token stored (item $TOKEN_SERVICE); pnpm dev now starts with 1Password locked"
      else need "the token was not stored; run setup again"; fi
    fi
    unset shared; return
  fi
  unset shared
  if token_present; then ok "token in the keychain (not compared with $TOKEN_REF: 1Password locked, or no Engineering vault access)"; return; fi
  note "no token in the keychain, and $TOKEN_REF is not readable (1Password locked, or no Engineering vault access). Only engineers running dev servers need one: unlock 1Password and run lobsters-cli token sync"
}

# Every dev Environment the 1Password app can list, "id<TAB>name" per line, through the app's MCP
# server (the only listing there is: stable op has no `environment list`). Empty when the app is
# locked, the server is not installed, or the app is on another account; the caller says so.
mcp_dev_environments() {
  local bin
  bin="$(command -v 1password-mcp 2>/dev/null)" || bin="/Applications/1Password.app/Contents/MacOS/1password-mcp"
  [ -x "$bin" ] && command -v python3 >/dev/null || return 1
  timeout 45 python3 -I - "$bin" <<'PY' 2>/dev/null
import json, subprocess, sys
p = subprocess.Popen([sys.argv[1]], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
n = 0
def rpc(method, params=None, notify=False):
    global n
    msg = {'jsonrpc': '2.0', 'method': method}
    if params is not None: msg['params'] = params
    if not notify: n += 1; msg['id'] = n
    p.stdin.write(json.dumps(msg) + '\n'); p.stdin.flush()
    if notify: return None
    for line in p.stdout:
        r = json.loads(line)
        if r.get('id') == n: return r
rpc('initialize', {'protocolVersion': '2025-06-18', 'capabilities': {}, 'clientInfo': {'name': 'lobsters-cli', 'version': '0'}})
rpc('notifications/initialized', notify=True)
def call(name, **a):
    r = rpc('tools/call', {'name': name, 'arguments': a})['result']
    t = ''.join(c.get('text', '') for c in r.get('content', []))
    if r.get('isError'): sys.exit(1)
    return json.loads(t)
acct = call('authenticate')['account_id']
for e in call('list_environments', accountId=acct)['environments']:
    if e['name'].endswith('/development'): print(e['environmentId'] + '\t' + e['name'])
p.stdin.close()
PY
}

# lobsters-cli token sync [--shared] | check
cmd_token() {
  local f id name tok where n=0 bad=0 checked=""
  case "${1:-}" in
    sync)
      MODE=install; lobster_banner "v$(installed_version)" "the shared dev-readers token"
      setup_token "$([ "${2:-}" = --shared ] && echo force)"; echo ;;
    check)
      # Every cloned repo's scripts/op-env.sh names its Environment; try each with the keychain token.
      MODE=check; lobster_banner "v$(installed_version)" "which dev Environments the keychain token can read"
      step "Environments named by scripts/op-env.sh under $(tilde "$CODE_DIR")"
      token_present || { need "no token in the keychain: lobsters-cli token sync"; return 1; }
      tok="$(token_read)"
      for f in "$CODE_DIR"/*/scripts/op-env.sh "$CODE_DIR"/*/*/scripts/op-env.sh; do
        [ -f "$f" ] || continue
        id="$(grep '^OP_ENVIRONMENT_ID=' "$f" | head -1 | cut -d= -f2 | tr -d '\"'"'"' ')"; [ -n "$id" ] || continue
        name="$(sed -n 's/^# Run a command with the \([^ ]*\) 1Password.*/\1/p' "$f" | head -1)"
        n=$((n+1)); checked="$checked $id"; where="$(dirname "$(dirname "$f")")"; where="$(tilde "$where")"
        if OP_SERVICE_ACCOUNT_TOKEN="$tok" op run --environment "$id" -- true </dev/null >/dev/null 2>&1; then ok "${name:-$id}  [$where]"
        else need "${name:-$id}  [$where]: the token cannot read it. An admin adds it to the dev-readers service account, or recreates it, and updates $TOKEN_REF"; bad=$((bad+1)); fi
      done
      # Then every dev Environment the app lists, cloned or not: a new project's Environment
      # shows up here before anyone has its repo, which is when dev-readers must gain it.
      step "Every dev Environment the 1Password app lists"
      local listed seen=" $checked " any=0
      listed="$(mcp_dev_environments)" || listed=""
      if [ -z "$listed" ]; then note "could not list them: the 1Password app is locked, on another account, or has no MCP server here. Unlock it (Cloud Lobsters account) and run again"
      else
        while IFS=$'\t' read -r id name; do
          [ -n "$id" ] || continue; any=1
          case "$seen" in *" $id "*) continue ;; esac
          n=$((n+1))
          if OP_SERVICE_ACCOUNT_TOKEN="$tok" op run --environment "$id" -- true </dev/null >/dev/null 2>&1; then ok "$name"
          else need "$name: the token cannot read it. An admin adds it to the dev-readers service account, or recreates it, and updates $TOKEN_REF"; bad=$((bad+1)); fi
        done <<< "$listed"
        [ $any = 1 ] || note "the app listed no dev Environment: it is on another account"
      fi
      unset tok
      step "Done"; echo "  $n Environment(s) checked, $bad not readable."; [ $bad = 0 ] ;;
    *) echo "usage: lobsters-cli token sync [--shared] | check" >&2; return 2 ;;
  esac
}

# ---- the tailnet -------------------------------------------------------------------------
# Every person's machine is on the company tailnet: that is how they reach the hub (Tailscale
# SSH, by identity) and the office. setup installs Tailscale, gets them signed in with their
# Workspace account, says when the device is waiting for an admin's approval, and writes an
# `ssh lobster` entry that lands in their own account on the hub. Not on the hub itself.
# On a Mac the Tailscale app is the client (it drives the network extension); its CLI lives
# inside the bundle. Homebrew's `tailscale` cask is now the CLI-only build, which needs its
# own daemon and is not what a laptop wants: the cask to install is `tailscale-app`.
ts_cli() {
  if [ $OS = mac ] && [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then echo /Applications/Tailscale.app/Contents/MacOS/Tailscale
  elif command -v tailscale >/dev/null; then echo tailscale
  else return 1; fi
}
setup_tailnet() {
  step "7. Tailscale (the company tailnet: the hub and the office)"
  [ $HUB = 1 ] && { ok "this is the hub"; return; }
  local ts st state login me host entry="$HOME/.ssh/config"
  if [ $OS = mac ] && [ ! -d /Applications/Tailscale.app ] && command -v brew >/dev/null && brew list --cask tailscale >/dev/null 2>&1; then
    if act "replace Homebrew's CLI-only tailscale cask with the Tailscale app (tailscale-app)"; then
      brew uninstall --cask tailscale >/dev/null 2>&1 || need "could not remove the tailscale cask: brew uninstall --cask tailscale"
    fi
  fi
  if ! ts="$(ts_cli)" || { [ $OS = mac ] && [ ! -d /Applications/Tailscale.app ]; }; then
    if act "install Tailscale"; then
      case $OS in
        mac)   command -v brew >/dev/null && brew install --cask tailscale-app >/dev/null 2>&1 || need "install the Tailscale app from tailscale.com/download (or: brew install --cask tailscale-app)" ;;
        linux) if command -v pacman >/dev/null; then sudo pacman -S --needed --noconfirm tailscale >/dev/null 2>&1 && sudo systemctl enable --now tailscaled >/dev/null 2>&1
               elif command -v apt-get >/dev/null; then curl -fsSL https://tailscale.com/install.sh | sh >/dev/null 2>&1
               fi || need "install Tailscale: tailscale.com/download" ;;
      esac
      ts="$(ts_cli)" || return
    else return; fi
  fi
  [ $OS = mac ] && ! pgrep -xq Tailscale && [ $MODE != check ] && open -a Tailscale 2>/dev/null && sleep 2
  st="$("$ts" status --json 2>/dev/null)" || st=""
  state="$(echo "$st" | jq -r '.BackendState // "Stopped"' 2>/dev/null)"
  login="$(echo "$st" | jq -r '.User[(.Self.UserID|tostring)].LoginName // .Self.UserProfile.LoginName // empty' 2>/dev/null)"
  case "$state" in
    Running)
      case "$login" in
        *@"$TAILNET_DOMAIN") ok "on the company tailnet as $login" ;;
        "")                  ok "on the tailnet" ;;
        *) need "Tailscale is signed in as $login, not a @$TAILNET_DOMAIN account: $ts login (Google, your work account), then $ts switch to it"; return ;;
      esac ;;
    NeedsMachineAuth) need "this device is waiting for an admin to approve it on the tailnet (ask Nemo or Duncan); then run setup again"; return ;;
    NeedsLogin|NoState|Stopped|"")
      if act "sign in to the company tailnet (a browser opens: Google, your @$TAILNET_DOMAIN account)"; then
        if [ $OS = mac ]; then open -a Tailscale 2>/dev/null; need "sign in from the Tailscale menu-bar icon with your @$TAILNET_DOMAIN Google account, then run setup again"
        else sudo "$ts" up --accept-routes 2>&1 | sed 's/^/    /'; fi
        st="$("$ts" status --json 2>/dev/null)"; state="$(echo "$st" | jq -r '.BackendState // ""')"
        [ "$state" = Running ] && ok "on the tailnet" || { [ "$state" = NeedsMachineAuth ] && need "signed in; the device is waiting for an admin to approve it. Then run setup again"; return; }
      else return; fi ;;
    *) need "Tailscale is $state; $ts status says more"; return ;;
  esac
  # ssh lobster → the person's own account on the hub, by Tailscale identity (no key).
  me="${login%@*}"; [ -n "$me" ] || return
  if [ -f "$entry" ] && grep -qiE '^Host[[:space:]]+(.*[[:space:]])?lobster([[:space:]]|$)' "$entry"; then ok "ssh lobster is configured"
  elif act "add 'ssh lobster' to ~/.ssh/config (your account $me on $HUB_NAME)"; then
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    { [ -s "$entry" ] && echo; printf 'Host lobster
    HostName %s
    User %s
' "$HUB_NAME" "$me"; } >> "$entry"; chmod 600 "$entry"
    ok "ssh lobster lands in your account on the hub"
  fi
}

run_setup() {
  case $MODE in
    check)  lobster_banner "v$(installed_version)" "check only: nothing changes" ;;
    remove) lobster_banner "v$(installed_version)" "taking the team setup out" ;;
    *)      lobster_banner "v$(installed_version)" "$TAGLINE" ;;
  esac
  setup_prereqs
  if [ $MODE = remove ]; then
    setup_managed; setup_rules; setup_mcp
    for f in "$CLAUDE"/skills/* "$CLAUDE"/agents/*; do
      [ -L "$f" ] && case "$(readlink "$f")" in "$RULES"/*) doing "unlink $(tilde "$f")"; rm -f "$f" ;; esac
    done
    if [ "$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null)" = "$PREFIX/bin/lobsters-cli statusline" ]; then
      if [ -s "$OWN_STATUSLINE" ]; then
        doing "put your own status line back"
        jq --arg sl "$(cat "$OWN_STATUSLINE")" '.statusLine.command = $sl' "$SETTINGS" | write_through "$SETTINGS"
      else doing "remove the team status line"; jq 'del(.statusLine)' "$SETTINGS" | write_through "$SETTINGS"; fi
      rm -f "$OWN_STATUSLINE"
    fi
    if [ $OS = mac ]; then
      local sb; sb="$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)"
      [ -n "$sb" ] && [ -L "$sb/lobsters-cli.5m.sh" ] && { doing "remove the SwiftBar plugin"; rm -f "$sb/lobsters-cli.5m.sh"; }
      [ -f "$SWIFTBAR_LOGIN" ] && { doing "stop starting SwiftBar at login"; rm -f "$SWIFTBAR_LOGIN"; }
    fi
    token_present && note "your 1Password service-account token stays in the keychain (remove it: $(token_remove_hint))"
    rm -f "$STATE"
    step "Done"; echo "  Left in place: $(tilde "$RULES"), $(tilde "$BASECAMP"), SwiftBar and your model settings. The package itself: sudo rm -r $PREFIX/bin/lobsters-cli $LIBEXEC $SHARE"
    return
  fi
  setup_migrate_old
  setup_managed; setup_rules; setup_model; setup_mcp; setup_extras; setup_token; setup_tailnet
  [ $MODE = check ] || { mkdir -p "$STATE_DIR"; touch "$STATE_DIR/last-sync"; cmd_status >/dev/null; }
  step "Done"
  if [ $todo = 0 ]; then echo "  All set (lobsters-cli $(installed_version)). Start a new Claude Code session; accept the one-time managed-hook dialog; sign in to Ref with /mcp."
  else echo "  $todo thing(s) still to do$([ $MODE = check ] && echo '. Run lobsters-cli setup to do them')."; fi
}

# ---- releases: verify, install-files, upgrade --------------------------------------
# verify_release DIR SIGNERS ASSET: DIR holds ASSET (the tarball), SHA256SUMS and SHA256SUMS.sig.
# SIGNERS = allowed_signers to trust (the installed one on upgrade; the tarball's own on first install).
# A release from the rename is signed in the old namespace and lists the tarball under its old
# name, so either namespace is accepted and the tarball is matched by its hash, not its name.
verify_release() {
  local dir="$1" signers="$2" asset="$3" sum
  [ -s "$signers" ] && grep -qv '^#' "$signers" || die "no maintainer key in $signers; refusing to install an unverifiable release"
  { ssh-keygen -Y verify -f "$signers" -I "$SIGNER" -n "$NAMESPACE" -s "$dir/SHA256SUMS.sig" < "$dir/SHA256SUMS" \
    || ssh-keygen -Y verify -f "$signers" -I "$SIGNER" -n "$LEGACY_NAMESPACE" -s "$dir/SHA256SUMS.sig" < "$dir/SHA256SUMS"; } >/dev/null 2>&1 \
    || die "SHA256SUMS is not signed by a maintainer key in $signers. Not installing."
  sum="$(sha256 < "$dir/$asset" | cut -d' ' -f1)"
  grep -q "^$sum " "$dir/SHA256SUMS" || die "checksum mismatch for $asset. Not installing."
}

# release_notes FILE FROM TO: print the CHANGELOG.md sections for the versions after FROM up
# to TO (only TO's own when FROM is empty), as the file orders them. A section is a
# `## X.Y.Z ...` heading and its lines up to the next heading. False when there are none.
release_notes() {
  local file="$1" from="$2" to="$3" v keep=0 found=0 line
  [ -f "$file" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "## "*)
        v="${line#\#\# }"; v="${v%% *}"; v="${v#v}"; keep=0
        [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
        if [ -z "$from" ]; then [ "$v" = "$to" ] || continue
        else version_lt "$from" "$v" && ! version_lt "$to" "$v" || continue; fi
        [ $found = 1 ] && echo; keep=1; found=1; printf '  \033[1m%s\033[0m\n' "${line#\#\# }" ;;
      "#"*) keep=0 ;;
      *) [ $keep = 1 ] && [ -n "$line" ] && printf '  %s\n' "$line" ;;
    esac
  done < "$file"
  [ $found = 1 ]
}

# install-files SRC: copy a verified, unpacked release tree into $PREFIX. Runs as root.
cmd_install_files() {
  local src="$1"
  [ "$(id -u)" = 0 ] || die "install-files must run as root"
  [ -f "$src/VERSION" ] && [ -x "$src/bin/lobsters-cli" ] || die "$src is not a lobsters-cli tree"
  install -d -m 0755 "$PREFIX/bin" "$LIBEXEC" "$SHARE/swiftbar" "$SHARE/waybar"
  install -m 0755 "$src/bin/lobsters-cli" "$PREFIX/bin/lobsters-cli"
  install -m 0755 "$src/libexec/rules-sync" "$LIBEXEC/rules-sync"
  install -m 0644 "$src/VERSION" "$src/share/allowed_signers" "$src/share/managed-settings.json" "$src/share/mcp-servers.json" "$SHARE/"
  install -m 0755 "$src/share/swiftbar/lobsters-cli.5m.sh" "$SHARE/swiftbar/"
  install -m 0755 "$src/share/waybar/lobsters-cli.sh" "$SHARE/waybar/"
  install -m 0644 "$src/share/waybar/README.md" "$SHARE/waybar/"
  echo "installed lobsters-cli $(cat "$src/VERSION") to $PREFIX"
}

cmd_upgrade() {
  local want="${1:-}" inst lat tmp tree asset base
  inst="$(installed_version)"
  lat="$(latest_version --fresh)"; [ -n "$lat" ] || die "could not read releases of $TOOLING_REPO (offline?)"
  if [ -z "$want" ]; then
    want="$lat"
    if ! version_lt "$inst" "$want"; then
      lobster_banner "v$inst" "up to date"
      echo "lobsters-cli $inst is current."; cmd_status >/dev/null; return 0
    fi
  elif version_lt "$want" "$inst"; then
    echo "Note: $want is older than the installed $inst. Installing it anyway because you named it." >&2
  fi
  lobster_banner "v$inst → v$want" "$TAGLINE"
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  asset="lobsters-cli-$want.tar.gz"; base="https://github.com/$TOOLING_REPO/releases/download/v$want"
  echo "Fetching lobsters-cli $want..."
  for f in "$asset" SHA256SUMS SHA256SUMS.sig; do
    curl -fsSL --retry 2 -o "$tmp/$f" "$base/$f" 2>/dev/null \
      || gh release download "v$want" --repo "$TOOLING_REPO" --pattern "$f" --dir "$tmp" >/dev/null 2>&1 \
      || die "could not download $f for v$want"
  done
  verify_release "$tmp" "$SHARE/allowed_signers" "$asset"
  tar -xzf "$tmp/$asset" -C "$tmp"
  tree="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d -name "*lobsters-cli-$want" | head -1)"   # old or new folder name
  [ -n "$tree" ] && [ -x "$tree/bin/lobsters-cli" ] || die "unexpected archive layout"
  echo "Verified: signed by a maintainer, checksums match."
  echo
  if version_lt "$inst" "$want"; then echo "Release notes ($inst → $want):"; release_notes "$tree/CHANGELOG.md" "$inst" "$want"
  else echo "Release notes ($want):"; release_notes "$tree/CHANGELOG.md" "" "$want"; fi \
    || echo "  (this release ships no notes)"
  echo
  echo "Changes to what runs on this machine ($inst → $want):"
  diff -u "$SHARE/managed-settings.json" "$tree/share/managed-settings.json" | sed -n '3,$p' | sed 's/^/  /' || true
  diff -q "$LIBEXEC/rules-sync" "$tree/libexec/rules-sync" >/dev/null 2>&1 || echo "  rules-sync (the session hook) changed; diff: diff -u $LIBEXEC/rules-sync $tree/libexec/rules-sync"
  diff -q "$PREFIX/bin/lobsters-cli" "$tree/bin/lobsters-cli" >/dev/null 2>&1 || echo "  lobsters-cli (this CLI) changed"
  diff -q "$SHARE/mcp-servers.json" "$tree/share/mcp-servers.json" >/dev/null 2>&1 || echo "  mcp-servers.json changed"
  echo
  printf 'Install %s? [y/N] ' "$want"; read -r yn </dev/tty
  case "$yn" in y|Y|yes) ;; *) echo "Not installed."; return 1 ;; esac
  sudo "$PREFIX/bin/lobsters-cli" install-files "$tree" || die "install failed"
  echo; echo "Applying the new policy..."
  LOBSTERS_CLI_NO_BANNER=1 exec "$PREFIX/bin/lobsters-cli" setup
}

# ---- hub: the shared agent box ---------------------------------------------------------
# One Linux machine (the office Mac Pro "lobster") that everyone reaches over Tailscale SSH and
# that runs Claude Code and Orca for them. Every person has their own Unix account there, named
# after the local part of their login email, so commits, pushes and Orca sessions carry their
# own identity; Tailscale SSH maps nemo@example.com to the account "nemo" by itself with the
# policy rule  {"src": ["autogroup:member"], "dst": ["tag:server"], "users": ["localpart:*@example.com"]}.
# Claude Code in each home is signed in as the company account; gh and git as the person.
#
#   sudo lobsters-cli hub init [--orca PATH] [--retire USER] [--domain D]   once, on the box
#   sudo lobsters-cli hub token dev-readers|tailscale   store a secret, piped in from an admin's 1Password
#   sudo lobsters-cli hub add EMAIL [--sudo]            the account, its Orca server, its token
#   sudo lobsters-cli hub remove EMAIL [--keep-home]
#   sudo lobsters-cli hub list | check
#   sudo lobsters-cli hub tailnet EMAIL [--approve]     the person's tailnet devices; approve the pending ones
#
# On disk (root only): $HUB_CONF (settings), $HUB_DIR/people (registry: user email port sudo added),
# $HUB_DIR/dev-readers and $HUB_DIR/tailscale (secrets, 0600), $HUB_LIB/Orca.AppImage.
# Secrets reach the box piped over ssh from `op read` on an admin's laptop; `hub init` adds a sudoers
# line so that `hub token` alone needs no password (it only ever writes).
HUB_PEOPLE="$HUB_DIR/people"
hub_root() { [ "$(id -u)" = 0 ] || die "lobsters-cli hub $1 runs as root: sudo lobsters-cli hub $1 ..."; }
hub_load() { [ -f "$HUB_CONF" ] || die "this machine is not a hub yet: sudo lobsters-cli hub init"; . "$HUB_CONF"; }
hub_user_of() { local e; e="$(echo "$1" | tr 'A-Z' 'a-z')"; case "$e" in *@"$HUB_DOMAIN") echo "${e%@*}" ;; *) die "$1 is not a $HUB_DOMAIN login; Tailscale SSH maps the local part of that domain to the account" ;; esac; }
hub_entry() { grep "^$1 " "$HUB_PEOPLE" 2>/dev/null | head -1; }           # by user
hub_next_port() { local max; max="$(awk '{print $3}' "$HUB_PEOPLE" 2>/dev/null | sort -n | tail -1)"; echo $(( ${max:-$((HUB_PORT_FROM-1))} + 1 )); }
hub_user_systemctl() { local u="$1"; shift; systemctl --user -M "$u@" "$@"; }   # the person's user manager (linger keeps it up)
hub_ufw_active() { command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; }

hub_init() {
  hub_root init
  local orca="" retire="" domain="" ip
  while [ $# -gt 0 ]; do case "$1" in
    --orca) orca="${2:?}"; shift 2 ;; --retire) retire="${2:?}"; shift 2 ;; --domain) domain="${2:?}"; shift 2 ;;
    *) die "hub init: unknown option $1" ;; esac; done
  [ -f "$HUB_CONF" ] && . "$HUB_CONF"
  lobster_banner "v$(installed_version)" "this machine becomes the shared agent box"
  step "1. This machine"
  [ $OS = linux ] || die "a hub is a Linux box"
  command -v tailscale >/dev/null || die "tailscale is not installed"
  ip="$(tailscale ip -4 2>/dev/null | head -1)"; [ -n "$ip" ] || die "tailscale is not up (tailscale up)"
  ok "Tailscale IP $ip"
  [ -n "$domain" ] || domain="$(tailscale status --json 2>/dev/null | jq -r '[.User[]? | .LoginName | select(contains("@"))][0] // empty' | sed 's/.*@//')"
  [ -n "$domain" ] || die "could not tell the login domain from the tailnet; give it: --domain example.com"
  ok "logins are @$domain; the account name is the part before the @"
  if tailscale status --self --json 2>/dev/null | jq -e '.Self.Tags // [] | index("tag:server")' >/dev/null; then ok "tagged tag:server (no key expiry, no single owner)"
  else need "tag this machine tag:server in the Tailscale console (machine → Edit ACL tags)"; fi
  if [ "$(tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false')" = true ]; then ok "Tailscale SSH on"
  else doing "turn on Tailscale SSH"; tailscale set --ssh || need "could not turn on Tailscale SSH"; fi
  note "policy rule to have: {\"src\": [\"autogroup:member\"], \"dst\": [\"tag:server\"], \"users\": [\"localpart:*@$domain\"]} (action check for a browser re-auth every 12h)"
  step "2. Orca (one copy per person; the AppImage updates itself in place)"
  [ -n "$orca" ] || orca="$(ls /home/*/Applications/orca/Orca.AppImage 2>/dev/null | head -1)"
  [ -n "$orca" ] && [ -f "$orca" ] || die "no Orca AppImage found under /home/*/Applications/orca; give one: --orca /path/to/Orca.AppImage"
  install -d -m 0755 "$HUB_LIB"
  if cmp -s "$orca" "$HUB_LIB/Orca.AppImage"; then ok "$HUB_LIB/Orca.AppImage"
  else doing "keep a copy of $orca at $HUB_LIB"; install -m 0755 "$orca" "$HUB_LIB/Orca.AppImage"; fi
  step "3. Tools and policy for every account"
  # gh and jq for everyone: Omarchy's gh is a per-user mise stub in the first account only.
  local t
  for t in gh:github-cli jq:jq; do
    if command -v "${t%%:*}" >/dev/null && [ "$(command -v "${t%%:*}")" != "/home/"* ]; then ok "${t%%:*}"
    elif command -v pacman >/dev/null; then doing "install ${t#*:} for every account"; pacman -S --needed --noconfirm "${t#*:}" >/dev/null 2>&1 && ok "${t%%:*}" || need "${t#*:} did not install (pacman -S ${t#*:})"
    elif command -v apt-get >/dev/null; then doing "install ${t#*:} for every account"; apt-get install -y "${t#*:}" >/dev/null 2>&1 && ok "${t%%:*}" || need "${t#*:} did not install (apt install ${t#*:})"
    else need "install ${t%%:*} system-wide"; fi
  done
  if command -v op >/dev/null; then ok "1Password CLI $(op --version 2>/dev/null)"
  elif command -v pacman >/dev/null; then doing "install the 1Password CLI"; pacman -S --needed --noconfirm 1password-cli >/dev/null 2>&1 && ok "1Password CLI" || need "1password-cli did not install (pacman -S 1password-cli)"
  else need "install the 1Password CLI (op) 2.41 or later: developer.1password.com/docs/cli"; fi
  if [ -f "$MANAGED" ] && cmp -s "$SHARE/managed-settings.json" "$MANAGED"; then ok "team policy on for every account ($MANAGED)"
  else doing "install the team policy to $MANAGED"; install -d -m 0755 "$MANAGED_DIR"; install -m 0644 "$SHARE/managed-settings.json" "$MANAGED"; fi
  if [ -f /etc/sudoers.d/lobsters-cli-hub ]; then ok "wheel may run hub token without a password (so a secret can be piped in over ssh)"
  else
    doing "let wheel run hub token without a password"
    echo "%wheel ALL=(root) NOPASSWD: $PREFIX/bin/lobsters-cli hub token *" > /etc/sudoers.d/lobsters-cli-hub.tmp
    if visudo -cf /etc/sudoers.d/lobsters-cli-hub.tmp >/dev/null 2>&1; then install -m 0440 /etc/sudoers.d/lobsters-cli-hub.tmp /etc/sudoers.d/lobsters-cli-hub; else need "sudoers line rejected by visudo"; fi
    rm -f /etc/sudoers.d/lobsters-cli-hub.tmp
  fi
  hub_ufw_active && ok "ufw is active: each person's Orca port is opened on tailscale0 by hub add" || note "ufw is not active; nothing to open"
  if [ -n "$retire" ]; then
    step "4. Retire the shared account's Orca server ($retire)"
    id "$retire" >/dev/null 2>&1 || die "no account $retire"
    local rh; rh="$(getent passwd "$retire" | cut -d: -f6)"
    if [ -f "$rh/.config/systemd/user/orca-serve.service" ]; then
      doing "stop and remove $retire's orca-serve.service (Orca ignores SIGTERM; this can take 90 s)"
      hub_user_systemctl "$retire" disable --now orca-serve.service >/dev/null 2>&1 || true
      mv -f "$rh/.config/systemd/user/orca-serve.service" "$rh/.config/systemd/user/orca-serve.service.retired"
      hub_user_systemctl "$retire" daemon-reload >/dev/null 2>&1 || true
      ok "orca-serve.service off for $retire (kept as orca-serve.service.retired)"
    else note "$retire has no orca-serve.service"; fi
    # The AppImage runs as /tmp/.mount_…/orca-ide …/cli/index.js serve, with an orcad-server child.
    pkill -u "$retire" -f 'orca-ide.* serve|orcad-server|daemon-entry\.js' 2>/dev/null && ok "stopped the Orca processes of $retire" || true
    note "the devices paired to it pair again, each with its owner's own server"
  fi
  step "5. Hub config"
  install -d -m 0700 "$HUB_DIR"; install -d -m 0755 "$(dirname "$HUB_CONF")"
  { echo "# written by lobsters-cli hub init on $(date -u +%F); edit by hand if the IP or domain changes"
    echo "HUB_IP=$ip"; echo "HUB_DOMAIN=$domain"; echo "HUB_PORT_FROM=${HUB_PORT_FROM:-6768}"; echo "HUB_SHELL=${HUB_SHELL:-/usr/bin/bash}"
    echo "HUB_RETIRED=${retire:-${HUB_RETIRED:-}}"; } > "$HUB_CONF"
  chmod 0644 "$HUB_CONF"; touch "$HUB_PEOPLE"; chmod 0600 "$HUB_PEOPLE"
  ok "$HUB_CONF written; setup now behaves as on a hub for every account"
  step "Done"
  echo "  Next, from an admin's laptop (the token never touches a clipboard):"
  echo "    op item get '$TOKEN_ITEM' --vault $TOKEN_VAULT --fields label=credential --reveal | ssh $(hostname) sudo lobsters-cli hub token dev-readers"
  echo "  then, for each person:  sudo lobsters-cli hub add name@$domain [--sudo]"
}

# hub token KIND: the secret on stdin (piped; or typed unseen at a terminal) into $HUB_DIR/KIND.
# dev-readers: the shared read-only 1Password service account, copied into every home.
# tailscale: an OAuth client (scopes users:read, devices:core) as two lines, id then secret.
hub_token() {
  hub_root token; hub_load
  local kind="${1:-}" tmp
  case "$kind" in dev-readers|tailscale) ;; *) die "hub token dev-readers | tailscale" ;; esac
  tmp="$(mktemp -p "$HUB_DIR")"
  if [ -t 0 ]; then
    case $kind in
      dev-readers) printf 'dev-readers token (not shown): '; IFS= read -rs line; echo; printf '%s\n' "$line" > "$tmp"; unset line ;;
      tailscale)   printf 'OAuth client id: '; IFS= read -r a; printf 'client secret (not shown): '; IFS= read -rs b; echo; printf '%s\n%s\n' "$a" "$b" > "$tmp"; unset a b ;;
    esac
  else cat > "$tmp"; fi
  case $kind in
    dev-readers) grep -q '^ops_' "$tmp" || { rm -f "$tmp"; die "that is not a 1Password service-account token (ops_…)"; } ;;
    tailscale)   [ "$(grep -c . "$tmp")" = 2 ] || { rm -f "$tmp"; die "expected two lines: client id, then client secret"; } ;;
  esac
  chmod 0600 "$tmp"; mv -f "$tmp" "$HUB_DIR/$kind"
  echo "stored $HUB_DIR/$kind"
  if [ $kind = dev-readers ]; then
    local u h n=0
    while read -r u _; do [ -n "$u" ] || continue; h="$(getent passwd "$u" | cut -d: -f6)"; [ -d "$h" ] || continue; hub_place_token "$u" "$h" && n=$((n+1)); done < "$HUB_PEOPLE"
    echo "placed in $n home(s)"
  fi
}
# hub_place_token USER HOME: the shared token into that home's token file (what setup_token reads on a hub).
hub_place_token() {
  [ -s "$HUB_DIR/dev-readers" ] || return 1
  local f="$2/.config/cloud-lobsters/op-token"
  mkdir -p "$2/.config/cloud-lobsters" && chown "$1:$1" "$2/.config" "$2/.config/cloud-lobsters" && chmod 0700 "$2/.config/cloud-lobsters"
  install -m 0600 -o "$1" -g "$1" "$HUB_DIR/dev-readers" "$f" && echo "$TOKEN_LABEL" > "$f.label" && chown "$1:$1" "$f.label"
}

hub_add() {
  hub_root add; hub_load
  local email="" sudo=0 u h port extra="" entry
  while [ $# -gt 0 ]; do case "$1" in --sudo) sudo=1; shift ;; -*) die "hub add: unknown option $1" ;; *) email="$1"; shift ;; esac; done
  [ -n "$email" ] || die "hub add EMAIL [--sudo]"
  email="$(echo "$email" | tr 'A-Z' 'a-z')"; u="$(hub_user_of "$email")"
  [[ "$u" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "'$u' cannot be a Unix account name; give the person a plainer login alias"
  case "$u" in *.*) extra="--badname" ;; esac
  lobster_banner "v$(installed_version)" "$email on this hub"
  step "1. Account $u"
  if id "$u" >/dev/null 2>&1; then ok "exists"; else doing "create it"; useradd -m -s "$HUB_SHELL" $extra "$u" || die "useradd failed"; fi
  h="$(getent passwd "$u" | cut -d: -f6)"
  if [ $sudo = 1 ]; then
    # Omarchy's wheel group carries only a few fixed NOPASSWD commands; full sudo is per user.
    id -nG "$u" | tr ' ' '\n' | grep -qx wheel || usermod -aG wheel "$u"
    if [ -f "/etc/sudoers.d/lobsters-cli-hub-$u" ]; then ok "sudo (/etc/sudoers.d/lobsters-cli-hub-$u)"
    else
      doing "grant sudo (/etc/sudoers.d/lobsters-cli-hub-$u)"
      echo "$u ALL=(ALL:ALL) ALL" > "/etc/sudoers.d/.lobsters-cli-hub-$u.tmp"
      if visudo -cf "/etc/sudoers.d/.lobsters-cli-hub-$u.tmp" >/dev/null 2>&1; then install -m 0440 "/etc/sudoers.d/.lobsters-cli-hub-$u.tmp" "/etc/sudoers.d/lobsters-cli-hub-$u"; else need "sudoers line rejected by visudo"; fi
      rm -f "/etc/sudoers.d/.lobsters-cli-hub-$u.tmp"
    fi
    if [ "$(passwd -S "$u" 2>/dev/null | awk '{print $2}')" = P ]; then ok "has a password for sudo"
    elif [ -t 0 ]; then echo "  sudo needs a password (Tailscale SSH never asks for one). Set a temporary one; the person changes it with passwd:"; passwd "$u" || need "no password set; sudo will not work until: sudo passwd $u"
    else need "set a password for sudo: sudo passwd $u"; fi
  else
    rm -f "/etc/sudoers.d/lobsters-cli-hub-$u"
    note "no sudo (add it later with hub add $email --sudo)"
  fi
  loginctl enable-linger "$u" 2>/dev/null && ok "services run with nobody logged in (linger)"
  step "2. Orca server"
  entry="$(hub_entry "$u")"
  if [ -n "$entry" ]; then port="$(echo "$entry" | awk '{print $3}')"; else port="$(hub_next_port)"; fi
  if ss -ltnH "sport = :$port" 2>/dev/null | grep -q . && ! hub_user_systemctl "$u" is-active orca-serve.service >/dev/null 2>&1; then
    need "port $port is taken by something that is not $u's Orca server (ss -ltnp 'sport = :$port'); stop it, or it will fight that server"
  fi
  ok "port $port on $HUB_IP"
  mkdir -p "$h/Applications/orca" "$h/.local/bin" "$h/.config/systemd/user" "$h/.config/orca"
  chown "$u:$u" "$h/Applications" "$h/Applications/orca" "$h/.local" "$h/.local/bin" "$h/.config" "$h/.config/systemd" "$h/.config/systemd/user" "$h/.config/orca"
  if [ -f "$h/Applications/orca/Orca.AppImage" ]; then ok "own copy of Orca"
  else doing "copy Orca into the home"; install -m 0755 -o "$u" -g "$u" "$HUB_LIB/Orca.AppImage" "$h/Applications/orca/Orca.AppImage" || die "no Orca at $HUB_LIB (hub init)"; fi
  ln -sfn "$h/Applications/orca/Orca.AppImage" "$h/.local/bin/orca-ide"; chown -h "$u:$u" "$h/.local/bin/orca-ide"
  cat > "$h/.config/systemd/user/orca-serve.service" <<UNIT
[Unit]
Description=Orca server for $u (port $port; written by lobsters-cli hub add)
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
ExecStart=$h/.local/bin/orca-ide serve --supervise --no-pairing --port $port --pairing-address $HUB_IP
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:$h/.local/share/mise/shims:$h/.local/bin
Environment=ORCA_USER_DATA_PATH=$h/.config/orca
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillMode=process

[Install]
WantedBy=default.target
UNIT
  chown "$u:$u" "$h/.config/systemd/user/orca-serve.service"
  cat > "$h/.local/bin/orca-pair" <<PAIR
#!/bin/bash
# Pair a phone or laptop with your Orca server on this hub (written by lobsters-cli hub add).
# Runs Orca in pairing mode, waits for the device to pair, then starts your real server.
set -u
dev="\$HOME/.config/orca/orca-devices.json"
count() { jq 'if type == "array" then length else 0 end' "\$dev" 2>/dev/null || echo 0; }
stop_pairing() { kill -TERM -- -\$pg 2>/dev/null; sleep 3; kill -KILL -- -\$pg 2>/dev/null; wait 2>/dev/null; }
before=\$(count)
systemctl --user stop orca-serve.service 2>/dev/null
echo "Pairing mode on $HUB_IP:$port. Open the link below (or scan the code) on the phone or laptop."
echo
setsid "\$HOME/.local/bin/orca-ide" serve --port $port --pairing-address $HUB_IP &
pg=\$!
trap 'echo; echo "Stopped. Your server starts again."; stop_pairing; systemctl --user start orca-serve.service; exit 130' INT TERM
while kill -0 "\$pg" 2>/dev/null; do
  sleep 2
  if [ "\$(count)" -gt "\$before" ]; then
    echo; echo "Paired. Starting your Orca server on $HUB_IP:$port."
    trap - INT TERM; stop_pairing
    systemctl --user start orca-serve.service && echo "Done. Run orca-pair again for another device." || echo "orca-serve did not start: journalctl --user -u orca-serve"
    exit 0
  fi
done
echo "Pairing mode ended without a new device. Your server starts again."; systemctl --user start orca-serve.service
PAIR
  chmod 0755 "$h/.local/bin/orca-pair"; chown "$u:$u" "$h/.local/bin/orca-pair"
  if hub_user_systemctl "$u" daemon-reload >/dev/null 2>&1 && hub_user_systemctl "$u" enable orca-serve.service >/dev/null 2>&1; then ok "orca-serve.service enabled (runs with the account's session manager; orca-pair stops it to pair)"
  else
    install -d -o "$u" -g "$u" "$h/.config/systemd/user/default.target.wants"
    ln -sfn ../orca-serve.service "$h/.config/systemd/user/default.target.wants/orca-serve.service"; chown -h "$u:$u" "$h/.config/systemd/user/default.target.wants/orca-serve.service"
    ok "orca-serve.service enabled (by link; the user manager was not up yet)"
  fi
  if hub_ufw_active; then
    ufw status | grep -q "^$port/tcp on tailscale0" && ok "ufw: $port/tcp open on tailscale0" \
      || { doing "ufw: open $port/tcp on tailscale0"; ufw allow in on tailscale0 to any port "$port" proto tcp comment "orca $u" >/dev/null || need "ufw rule failed"; }
  fi
  # First logins run the team setup by themselves, until it has completed once (status.json
  # is written at the end of a full setup). The person only answers the GitHub prompt.
  if ! grep -q 'lobsters-cli hub: first logins' "$h/.bashrc" 2>/dev/null; then
    printf '\n# lobsters-cli hub: first logins run the team setup until it has completed once\n[[ $- == *i* ]] && [ ! -s ~/.local/state/cloud-lobsters/status.json ] && command -v lobsters-cli >/dev/null && lobsters-cli setup\n' >> "$h/.bashrc"
    chown "$u:$u" "$h/.bashrc"; ok "first login runs lobsters-cli setup by itself"
  else ok "first login runs lobsters-cli setup by itself"; fi
  step "3. 1Password dev-readers token"
  if hub_place_token "$u" "$h"; then ok "placed in the home; op run works there with 1Password locked"
  else note "none stored yet: sudo lobsters-cli hub token dev-readers places it in every home"; fi
  { grep -v "^$u " "$HUB_PEOPLE" 2>/dev/null; echo "$u $email $port $([ $sudo = 1 ] && echo yes || echo no) $(date -u +%F)"; } > "$HUB_PEOPLE.tmp" && mv -f "$HUB_PEOPLE.tmp" "$HUB_PEOPLE"; chmod 0600 "$HUB_PEOPLE"
  step "Done"
  echo "  $email: account $u, Orca on $HUB_IP:$port. Tell them:"
  echo "    1. ssh $u@$(hostname)        (Tailscale SSH: their tailnet login is the key)"
  echo "    2. setup runs by itself      (gh auth login as themselves when it asks; then claude, signed in as the company account)"
  echo "    3. orca-pair                 (pair their phone or laptop, Ctrl-C, then systemctl --user start orca-serve)"
  [ $sudo = 1 ] && echo "    4. passwd                    (their own sudo password; tell them the temporary one out of band)"
  echo "  Their devices on the tailnet: sudo lobsters-cli hub tailnet $email --approve"
}

hub_remove() {
  hub_root remove; hub_load
  local email="" keep=0 u h port entry yn
  while [ $# -gt 0 ]; do case "$1" in --keep-home) keep=1; shift ;; -*) die "hub remove: unknown option $1" ;; *) email="$1"; shift ;; esac; done
  [ -n "$email" ] || die "hub remove EMAIL [--keep-home]"
  u="$(hub_user_of "$email")"; entry="$(hub_entry "$u")"; [ -n "$entry" ] || die "$email is not on this hub (hub list)"
  port="$(echo "$entry" | awk '{print $3}')"; h="$(getent passwd "$u" | cut -d: -f6)"
  printf 'Remove %s (account %s, Orca port %s)%s? [y/N] ' "$email" "$u" "$port" "$([ $keep = 1 ] && echo ', keeping the home' || echo ' and its home directory')"
  read -r yn </dev/tty; case "$yn" in y|Y|yes) ;; *) echo "Nothing removed."; return 1 ;; esac
  hub_user_systemctl "$u" disable --now orca-serve.service >/dev/null 2>&1 || true
  loginctl disable-linger "$u" 2>/dev/null || true
  loginctl terminate-user "$u" 2>/dev/null || true
  hub_ufw_active && ufw delete allow in on tailscale0 to any port "$port" proto tcp >/dev/null 2>&1 || true
  rm -f "/etc/sudoers.d/lobsters-cli-hub-$u"
  if [ $keep = 1 ]; then userdel "$u" 2>/dev/null || need "userdel $u failed (still logged in?)"; else userdel -r "$u" 2>/dev/null || need "userdel -r $u failed (still logged in?)"; fi
  grep -v "^$u " "$HUB_PEOPLE" > "$HUB_PEOPLE.tmp"; mv -f "$HUB_PEOPLE.tmp" "$HUB_PEOPLE"; chmod 0600 "$HUB_PEOPLE"
  echo "removed $u from this hub. Their tailnet access ends when they leave the Workspace; to end it sooner, remove them in the Tailscale console."
}

hub_list() {
  hub_root list; hub_load
  local u e port s d state
  [ -s "$HUB_PEOPLE" ] || { echo "nobody on this hub yet: sudo lobsters-cli hub add EMAIL"; return; }
  printf '%-12s %-32s %-6s %-5s %-10s %s\n' ACCOUNT LOGIN ORCA SUDO ADDED SERVER
  while read -r u e port s d; do
    [ -n "$u" ] || continue
    state="$(hub_user_systemctl "$u" is-active orca-serve.service 2>/dev/null || echo "-")"
    printf '%-12s %-32s %-6s %-5s %-10s %s\n' "$u" "$e" "$port" "$s" "$d" "$state"
  done < "$HUB_PEOPLE"
  echo "Orca address for everyone: $HUB_IP; policy rule: users [\"localpart:*@$HUB_DOMAIN\"]"
}

hub_check() {
  hub_root check; hub_load; MODE=check
  local u e port s d h paired
  lobster_banner "v$(installed_version)" "hub check: nothing changes"
  step "Hub"
  [ -f "$HUB_LIB/Orca.AppImage" ] && ok "Orca AppImage at $HUB_LIB" || need "no Orca AppImage: hub init --orca PATH"
  [ -s "$HUB_DIR/dev-readers" ] && ok "dev-readers token stored" || need "no dev-readers token: hub token dev-readers"
  [ -s "$HUB_DIR/tailscale" ] && ok "Tailscale OAuth client stored" || note "no Tailscale OAuth client (hub tailnet needs one: hub token tailscale)"
  [ "$(tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false')" = true ] && ok "Tailscale SSH on" || need "Tailscale SSH is off: tailscale set --ssh"
  [ -f "$MANAGED" ] && ok "team policy on" || need "team policy missing: hub init"
  while read -r u e port s d; do
    [ -n "$u" ] || continue
    step "$e ($u)"
    id "$u" >/dev/null 2>&1 || { need "no account; hub add $e"; continue; }
    h="$(getent passwd "$u" | cut -d: -f6)"
    [ -f "/var/lib/systemd/linger/$u" ] && ok "linger" || need "no linger: loginctl enable-linger $u"
    if [ "$s" = yes ]; then [ -f "/etc/sudoers.d/lobsters-cli-hub-$u" ] && ok "sudo" || need "no sudoers entry: hub add $e --sudo"; fi
    [ -f "$h/.config/systemd/user/orca-serve.service" ] && ok "orca-serve unit" || need "no orca-serve unit: hub add $e"
    paired="$(jq 'if type == "array" then length else 0 end' "$h/.config/orca/orca-devices.json" 2>/dev/null || echo 0)"
    case "$(hub_user_systemctl "$u" is-active orca-serve.service 2>/dev/null)" in
      active) ss -ltnH "sport = :$port" 2>/dev/null | grep -q . && ok "Orca serving on $port ($paired device(s))" || need "orca-serve active but nothing listens on $port" ;;
      *) [ "${paired:-0}" -gt 0 ] && need "Orca server not running ($paired paired): systemctl --user start orca-serve, as $u" || note "Orca not paired yet: orca-pair, as $u" ;;
    esac
    if hub_ufw_active; then ufw status | grep -q "^$port/tcp on tailscale0" && ok "ufw $port/tcp on tailscale0" || need "ufw: port $port not open: hub add $e"; fi
    [ -s "$h/.config/cloud-lobsters/op-token" ] && ok "dev-readers token in the home" || note "no token in the home (hub token dev-readers)"
    [ -s "$h/.config/gh/hosts.yml" ] && ok "gh signed in" || need "gh not signed in: gh auth login, as $u"
    [ -n "$(runuser -u "$u" -- git config --global user.email 2>/dev/null)" ] && ok "git identity: $(runuser -u "$u" -- git config --global user.email)" || need "no git identity: lobsters-cli setup, as $u"
    [ -s "$h/.claude/.credentials.json" ] && ok "Claude Code signed in" || need "Claude Code not signed in: claude, as $u"
    [ -f "$h/.claude/CLAUDE.md" ] && grep -qxF "$IMPORT" "$h/.claude/CLAUDE.md" && ok "team rules imported" || need "lobsters-cli setup not run, as $u"
  done < "$HUB_PEOPLE"
  step "Done"; echo "  $todo thing(s) to do."
}

# Tailscale API with the stored OAuth client (scopes users:read and devices:core).
hub_ts_token() {
  [ -s "$HUB_DIR/tailscale" ] || die "no Tailscale OAuth client stored: sudo lobsters-cli hub token tailscale (scopes users:read, devices:core)"
  local id secret t
  { IFS= read -r id; IFS= read -r secret; } < "$HUB_DIR/tailscale"
  t="$(curl -fsS -d "client_id=$id" -d "client_secret=$secret" https://api.tailscale.com/api/v2/oauth/token 2>/dev/null | jq -r '.access_token // empty')"
  unset secret
  [ -n "$t" ] || die "Tailscale did not issue a token for the stored OAuth client"
  echo "$t"
}
hub_tailnet() {
  hub_root tailnet; hub_load
  local email="" approve=0 tok users devs n id name
  while [ $# -gt 0 ]; do case "$1" in --approve) approve=1; shift ;; -*) die "hub tailnet: unknown option $1" ;; *) email="$1"; shift ;; esac; done
  [ -n "$email" ] || die "hub tailnet EMAIL [--approve]"
  email="$(echo "$email" | tr 'A-Z' 'a-z')"
  tok="$(hub_ts_token)"
  users="$(curl -fsS -H "Authorization: Bearer $tok" "https://api.tailscale.com/api/v2/tailnet/-/users" 2>/dev/null)" || die "could not list tailnet users (scope users:read?)"
  if echo "$users" | jq -e --arg e "$email" '.users[] | select((.loginName | ascii_downcase) == $e)' >/dev/null; then
    ok "$email is on the tailnet ($(echo "$users" | jq -r --arg e "$email" '.users[] | select((.loginName | ascii_downcase) == $e) | "\(.role), \(.status)"'))"
  else need "$email has not signed in to Tailscale yet (Workspace account; no invite needed)"; return 1; fi
  devs="$(curl -fsS -H "Authorization: Bearer $tok" "https://api.tailscale.com/api/v2/tailnet/-/devices" 2>/dev/null)" || die "could not list devices (scope devices:core?)"
  n=0
  while IFS=$'\t' read -r id name auth; do
    [ -n "$id" ] || continue
    if [ "$auth" = true ]; then ok "$name (approved)"; continue; fi
    if [ $approve = 1 ]; then
      if curl -fsS -X POST -H "Authorization: Bearer $tok" -H 'Content-Type: application/json' -d '{"authorized": true}' "https://api.tailscale.com/api/v2/device/$id/authorize" >/dev/null 2>&1; then ok "$name approved"; n=$((n+1))
      else need "$name: approval failed"; fi
    else need "$name is waiting for approval (--approve)"; fi
  done < <(echo "$devs" | jq -r --arg e "$email" '.devices[] | select((.user | ascii_downcase) == $e) | [.id, .name, (.authorized|tostring)] | @tsv')
  unset tok
  [ $approve = 1 ] && echo "$n device(s) approved."; return 0
}

cmd_hub() {
  case "${1:-help}" in
    init)    shift; hub_init "$@" ;;
    token)   shift; hub_token "$@" ;;
    add)     shift; hub_add "$@" ;;
    remove)  shift; hub_remove "$@" ;;
    list)    hub_list ;;
    check)   hub_check ;;
    tailnet) shift; hub_tailnet "$@" ;;
    help|-h|--help) sed -n '/^# ---- hub: the shared agent box/,/^HUB_PEOPLE=/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//; s/^---- //; s/ -*$//' ;;
    *) die "hub: unknown command $1 (lobsters-cli hub help)" ;;
  esac
}

# ---- main ----------------------------------------------------------------------------
case "${1:-}" in
  setup)         MODE=install; run_setup ;;
  check)         MODE=check;   run_setup ;;
  remove)        MODE=remove;  run_setup ;;
  upgrade)       cmd_upgrade "${2:-}" ;;
  status)        cmd_status ;;
  statusline)    cmd_statusline ;;
  token)         cmd_token "${2:-}" "${3:-}" ;;
  hub)           shift; cmd_hub "$@" ;;
  install-files) cmd_install_files "${2:?install-files needs a source directory}" ;;
  version|--version|-v) installed_version; echo ;;
  *) lobster_banner "v$(installed_version)" "$TAGLINE"
     sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
