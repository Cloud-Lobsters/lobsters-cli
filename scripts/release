#!/bin/bash
# Cut a release of lobsters-cli. Maintainers only; run from a clean checkout of main.
#
#   scripts/release 1.3.0
#   scripts/release 1.3.0 --yes     from a run with no terminal (the ! prefix in Claude Code):
#                                   you have read the notes and the commits and they match
#
# What it does, in order: checks CHANGELOG.md has notes for the release (under `## Unreleased`
# or `## X.Y.Z`; no notes, no release), names that section after the version, writes VERSION,
# commits, tags vX.Y.Z, builds the tarball with `git archive` (so the release is exactly the
# tag), writes SHA256SUMS, signs it with your release key (the one 1Password prompt), checks
# the signature against share/allowed_signers so a wrong key is caught here and not on
# someone's laptop, pushes, and creates the GitHub Release with the three files and the notes
# as its body. No CI, no secrets anywhere but your 1Password.
#
# Your key: an SSH key in 1Password whose public half is listed in share/allowed_signers.
# Point LOBSTERS_CLI_SIGNING_KEY at the public key file (default ~/.ssh/cloud-lobsters-release.pub);
# the 1Password SSH agent supplies the private half and asks you to approve, once.

set -eu
cd "$(dirname "$0")/.."
TOOLING_REPO="Cloud-Lobsters/lobsters-cli"
SIGNER="release@cloudlobsters.com"
NAMESPACE="lobsters-cli"
KEY="${LOBSTERS_CLI_SIGNING_KEY:-$HOME/.ssh/cloud-lobsters-release.pub}"
die() { printf 'release: %s\n' "$1" >&2; exit 1; }

# The private key lives in 1Password; its SSH agent signs. Prefer that agent when it is running.
for sock in "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" "$HOME/.1password/agent.sock"; do
  [ -S "$sock" ] && { export SSH_AUTH_SOCK="$sock"; break; }
done

v="${1:-}"; yes=0
[ "${2:-}" = --yes ] && yes=1
[[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ -z "${3:-}" ] && { [ -z "${2:-}" ] || [ $yes = 1 ]; } \
  || die "usage: scripts/release X.Y.Z [--yes]   (--yes: you have checked the notes against the commits; for a run with no terminal)"
[ "$(git symbolic-ref --short HEAD)" = main ] || die "release from main"
[ -z "$(git status --porcelain)" ] || die "working tree is not clean"
git fetch -q origin main && [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || die "main is not in sync with origin"
git rev-parse -q --verify "refs/tags/v$v" >/dev/null && die "v$v already exists"
[ -f "$KEY" ] || die "signing key $KEY not found (set LOBSTERS_CLI_SIGNING_KEY to your public key file)"
grep -qF "$(awk '{print $2}' "$KEY")" share/allowed_signers || die "$KEY is not in share/allowed_signers; add it in a commit first"
command -v gh >/dev/null && gh auth status >/dev/null 2>&1 || die "gh is not signed in"
banner() { sed -n '/^# ---- banner: the lobster/,/^# ---- end banner/p' "$1"; }
[ -n "$(banner install.sh)" ] && [ "$(banner install.sh)" = "$(banner bin/lobsters-cli)" ] \
  || die "the banner block differs between install.sh and bin/lobsters-cli; make them identical"

# Release notes: the CHANGELOG.md section for this version, or the Unreleased one, which the
# release commit names after the version. A section is its lines up to the next heading.
changelog_section() { awk -v h="$1" '
  /^#/ { if (on) exit; on = ($0 ~ "^## " h "( |$)") ; next }
  on { print }' CHANGELOG.md; }
has_text() { grep -q '[^[:space:]]' <<< "$1"; }
trim() { sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | sed '/./,$!d'; }   # blank lines at either end
notes="$(changelog_section "$v" | trim)"; from_unreleased=0
if ! has_text "$notes"; then
  notes="$(changelog_section Unreleased | trim)"; from_unreleased=1
  has_text "$notes" || die "CHANGELOG.md has no notes for $v. Write them under '## Unreleased' (one bullet per change, for the person upgrading), commit, and run this again. No notes, no release."
fi

# The maintainer checks the notes against what actually changed before anything is written.
last="$(git describe --tags --abbrev=0 2>/dev/null || true)"
echo "Release notes for $v:"; sed 's/^/  /' <<< "$notes"
if [ -n "$last" ]; then
  echo; echo "Commits since $last:"
  git log --format='  %s' "$last..HEAD" | grep -v '^  Merge ' || echo "  (none)"
fi
echo
if [ $yes = 1 ]; then echo "Notes checked against the commits (--yes)."
elif { : </dev/tty; } 2>/dev/null; then
  printf 'Do the notes cover every change a person would notice? [y/N] '; read -r yn </dev/tty
  case "$yn" in y|Y|yes) ;; *) die "add the missing notes under '## Unreleased', commit, and run this again" ;; esac
else
  die "no terminal to ask on. Read the notes and the commits above; if the notes cover every change a person would notice, run again with --yes. Nothing was written."
fi

if [ $from_unreleased = 1 ]; then
  # Name the section after the version and leave a fresh, empty Unreleased above it, so the
  # next change has somewhere to go. An empty one is refused above, so it cannot ship as is.
  awk -v new="## $v ($(date +%F))" '$0 == "## Unreleased" { print; print ""; print new; next } { print }' \
    CHANGELOG.md > CHANGELOG.md.tmp && mv CHANGELOG.md.tmp CHANGELOG.md
  git add CHANGELOG.md
fi

if [ "$(tr -d '[:space:]' < VERSION)" != "$v" ]; then
  echo "$v" > VERSION
  git add VERSION
fi
git diff --cached --quiet || git commit -q -m "release: v$v"
git tag -a "v$v" -m "lobsters-cli v$v"

asset="lobsters-cli-$v.tar.gz"; sums_name="$asset"; sign_ns="$NAMESPACE"; extra_asset=""
make_tarball() { git archive --format=tar.gz --prefix="lobsters-cli-$v/" -o "dist/$asset" "v$v"; }

# ---- transition from claude-lobsters-cli ---------------------------------------------
# Delete this block once every machine runs 0.3.0 or later (lobsters-cli status on each).
# A machine still on claude-lobsters-cli upgrades with its old CLI, which fetches
# claude-lobsters-cli-X.Y.Z.tar.gz, checks the signature in the old namespace against an
# allowed_signers that permits only that namespace, checks every line of SHA256SUMS against
# the files it has, expects the old top-level folder name, and installs bin/, swiftbar/ and
# waybar/ files by their old names. So the one tarball is built to satisfy all of that: the
# tag plus copies of the three renamed files under their old names, in a folder with the old
# name, uploaded under both names, listed once in SHA256SUMS (under the old name) and signed
# in the old namespace. The new CLI and install.sh accept either name, either namespace and
# either folder name, and match the tarball by its hash.
OLD="claude-lobsters-cli"
extra_asset="$OLD-$v.tar.gz"; sums_name="$extra_asset"; sign_ns="$OLD"
make_tarball() {
  local t; t="$(mktemp -d)"
  git archive --format=tar --prefix="$OLD-$v/" "v$v" | tar -xf - -C "$t"
  cp -p "$t/$OLD-$v/bin/lobsters-cli" "$t/$OLD-$v/bin/$OLD"
  cp -p "$t/$OLD-$v/share/swiftbar/lobsters-cli.5m.sh" "$t/$OLD-$v/share/swiftbar/$OLD.5m.sh"
  cp -p "$t/$OLD-$v/share/waybar/lobsters-cli.sh" "$t/$OLD-$v/share/waybar/$OLD.sh"
  tar -czf "dist/$asset" -C "$t" "$OLD-$v"
  rm -rf "$t"
}
# ---- end transition ------------------------------------------------------------------

rm -rf dist && mkdir dist
make_tarball
[ -z "$extra_asset" ] || cp "dist/$asset" "dist/$extra_asset"
( cd dist
  if command -v shasum >/dev/null; then shasum -a 256 "$sums_name" > SHA256SUMS; else sha256sum "$sums_name" > SHA256SUMS; fi
  echo "Signing SHA256SUMS with $KEY (1Password will ask once)..."
  ssh-keygen -Y sign -f "$KEY" -n "$sign_ns" SHA256SUMS
  ssh-keygen -Y verify -f ../share/allowed_signers -I "$SIGNER" -n "$sign_ns" -s SHA256SUMS.sig < SHA256SUMS >/dev/null \
    || { echo "release: the signature does not verify against share/allowed_signers" >&2; exit 1; }
)

git push -q origin main "v$v"
prev="$(git tag --sort=-v:refname | grep -v "^v$v\$" | head -1)"
{ printf '%s\n' "$notes"; [ -z "$prev" ] || printf '\n**Full changelog**: https://github.com/%s/compare/%s...v%s\n' "$TOOLING_REPO" "$prev" "$v"; } > dist/notes.md
gh release create "v$v" dist/*.tar.gz dist/SHA256SUMS dist/SHA256SUMS.sig --repo "$TOOLING_REPO" --title "v$v" --notes-file dist/notes.md
echo "Released v$v. Machines see it at their next session start and install it with: lobsters-cli upgrade"
