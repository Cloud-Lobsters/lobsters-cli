#!/bin/bash
# Cut a release of claude-team. Maintainers only; run from a clean checkout of main.
#
#   scripts/release 1.3.0
#
# What it does, in order: writes VERSION, commits, tags vX.Y.Z, builds the tarball with
# `git archive` (so the release is exactly the tag), writes SHA256SUMS, signs it with your
# release key (the one 1Password prompt), checks the signature against share/allowed_signers
# so a wrong key is caught here and not on someone's laptop, pushes, and creates the GitHub
# Release with the three files. No CI, no secrets anywhere but your 1Password.
#
# Your key: an SSH key in 1Password whose public half is listed in share/allowed_signers.
# Point CLAUDE_TEAM_SIGNING_KEY at the public key file (default ~/.ssh/cloud-lobsters-release.pub);
# the 1Password SSH agent supplies the private half and asks you to approve, once.

set -eu
cd "$(dirname "$0")/.."
TOOLING_REPO="Cloud-Lobsters/claude-team"
SIGNER="release@cloudlobsters.com"
NAMESPACE="claude-team"
KEY="${CLAUDE_TEAM_SIGNING_KEY:-$HOME/.ssh/cloud-lobsters-release.pub}"
die() { printf 'release: %s\n' "$1" >&2; exit 1; }

# The private key lives in 1Password; its SSH agent signs. Prefer that agent when it is running.
for sock in "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" "$HOME/.1password/agent.sock"; do
  [ -S "$sock" ] && { export SSH_AUTH_SOCK="$sock"; break; }
done

v="${1:-}"
[[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "usage: scripts/release X.Y.Z"
[ "$(git symbolic-ref --short HEAD)" = main ] || die "release from main"
[ -z "$(git status --porcelain)" ] || die "working tree is not clean"
git fetch -q origin main && [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || die "main is not in sync with origin"
git rev-parse -q --verify "refs/tags/v$v" >/dev/null && die "v$v already exists"
[ -f "$KEY" ] || die "signing key $KEY not found (set CLAUDE_TEAM_SIGNING_KEY to your public key file)"
grep -qF "$(awk '{print $2}' "$KEY")" share/allowed_signers || die "$KEY is not in share/allowed_signers; add it in a commit first"
command -v gh >/dev/null && gh auth status >/dev/null 2>&1 || die "gh is not signed in"
banner() { sed -n '/^# ---- banner: the lobster/,/^# ---- end banner/p' "$1"; }
[ -n "$(banner install.sh)" ] && [ "$(banner install.sh)" = "$(banner bin/claude-team)" ] \
  || die "the banner block differs between install.sh and bin/claude-team; make them identical"

if [ "$(tr -d '[:space:]' < VERSION)" != "$v" ]; then
  echo "$v" > VERSION
  git add VERSION
  git commit -q -m "release: v$v"
fi
git tag -a "v$v" -m "claude-team v$v"

rm -rf dist && mkdir dist
asset="claude-team-$v.tar.gz"
git archive --format=tar.gz --prefix="claude-team-$v/" -o "dist/$asset" "v$v"
( cd dist
  if command -v shasum >/dev/null; then shasum -a 256 "$asset" > SHA256SUMS; else sha256sum "$asset" > SHA256SUMS; fi
  echo "Signing SHA256SUMS with $KEY (1Password will ask once)..."
  ssh-keygen -Y sign -f "$KEY" -n "$NAMESPACE" SHA256SUMS
  ssh-keygen -Y verify -f ../share/allowed_signers -I "$SIGNER" -n "$NAMESPACE" -s SHA256SUMS.sig < SHA256SUMS >/dev/null \
    || { echo "release: the signature does not verify against share/allowed_signers" >&2; exit 1; }
)

git push -q origin main "v$v"
gh release create "v$v" "dist/$asset" dist/SHA256SUMS dist/SHA256SUMS.sig --repo "$TOOLING_REPO" --title "v$v" --generate-notes
echo "Released v$v. Machines see it at their next session start and install it with: claude-team upgrade"
